---
import "../styles/global.css";

import { getImage } from "astro:assets";

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PhotoLightbox from "../components/PhotoLightbox.astro";
import logoLifeFocus from "../assets/brand/LIFE FOCUS logo.svg?url";
import defaultOgImage from "../images/home/hero-main.jpg";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  robots?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = "Life Focus",
  description = "Photographe de mariage et de famille à Romans-sur-Isère, dans la Drôme.",
  canonicalUrl,
  ogImage,
  ogType = "website",
  robots,
  structuredData,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://www.lifefocus.fr");

const absoluteUrl = (value: string) => {
  const url = new URL(value, siteUrl);

  if (url.hostname === "lifefocus.fr") {
    url.hostname = "www.lifefocus.fr";
  }

  if (url.protocol === "http:") {
    url.protocol = "https:";
  }

  return url.toString();
};

const pageUrl = absoluteUrl(canonicalUrl ?? Astro.url.pathname);
const defaultSocialImage = await getImage({
  src: defaultOgImage,
  width: 1200,
  format: "jpg",
  quality: 82,
});
const defaultSocialImageUrl = absoluteUrl(defaultSocialImage.src);
const socialImageUrl = absoluteUrl(ogImage ?? defaultSocialImage.src);
const logoUrl = absoluteUrl(logoLifeFocus);
const siteIdentityGraph = [
  {
    "@type": "ProfessionalService",
    "@id": "https://www.lifefocus.fr/#life-focus",
    name: "Life Focus",
    url: "https://www.lifefocus.fr/",
    logo: logoUrl,
    image: defaultSocialImageUrl,
    description:
      "Photographe de mariage et de famille basé à Romans-sur-Isère, dans la Drôme.",
    telephone: "+33698900917",
    address: {
      "@type": "PostalAddress",
      streetAddress: "36 TER Rue André Chénier",
      postalCode: "26100",
      addressLocality: "Romans-sur-Isère",
      addressRegion: "Drôme",
      addressCountry: "FR",
    },
    founder: {
      "@id": "https://www.lifefocus.fr/#alexis-cosentino",
    },
    sameAs: [
      "https://www.instagram.com/life_focus_mariage/",
      "https://www.facebook.com/LifeFocusPhotographeValence/",
      "https://www.mariages.net/photo-mariage/life-focus-photographe--e180967/avis",
    ],
  },
  {
    "@type": "Person",
    "@id": "https://www.lifefocus.fr/#alexis-cosentino",
    name: "Alexis Cosentino",
    jobTitle: "Photographe",
    url: "https://www.lifefocus.fr/a-propos/",
    worksFor: {
      "@id": "https://www.lifefocus.fr/#life-focus",
    },
  },
  {
    "@type": "WebSite",
    "@id": "https://www.lifefocus.fr/#website",
    name: "Life Focus",
    url: "https://www.lifefocus.fr/",
    inLanguage: "fr-FR",
    publisher: {
      "@id": "https://www.lifefocus.fr/#life-focus",
    },
  },
];
const normalizeStructuredData = (
  value: Record<string, unknown> | Array<Record<string, unknown>> | undefined,
) =>
  (Array.isArray(value) ? value : value ? [value] : []).map(({ ["@context"]: _context, ...item }) => item);
const structuredDataGraph = {
  "@context": "https://schema.org",
  "@graph": [...siteIdentityGraph, ...normalizeStructuredData(structuredData)],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Life Focus" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="icon" href="/favicon.ico?v=3" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png?v=3" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-192.png?v=3" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Newsreader:opsz,wght@6..72,400&display=swap"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredDataGraph)}
    />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main class="site-main">
      <slot />
    </main>
    <PhotoLightbox />
    <Footer />
  </body>
</html>

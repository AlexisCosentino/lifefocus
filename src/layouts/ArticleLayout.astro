---
import ImageSlot from "../components/ImageSlot.astro";
import BaseLayout from "./BaseLayout.astro";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface ArticleData {
  title: string;
  seoTitle?: string;
  description: string;
  slug: string;
  publishedAt: Date;
  updatedAt?: Date;
  category: string;
  excerpt: string;
  featuredImage?: string;
  featuredImageAlt?: string;
}

const { article } = Astro.props as {
  article: ArticleData;
};

const canonicalUrl = `https://www.lifefocus.fr/conseils/${article.slug}/`;
const publishedAt = article.publishedAt.toISOString();
const updatedAt = (article.updatedAt ?? article.publishedAt).toISOString();
const articleImages = import.meta.glob<{ default: ImageMetadata }>(
  "../images/conseils/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);
const articleImage = articleImages[`../images/conseils/${article.slug}.jpg`]?.default;
const articleSocialImage = articleImage
  ? await getImage({
      src: articleImage,
      width: 1200,
      format: "jpg",
      quality: 82,
    })
  : undefined;
const articleSocialImageUrl = articleSocialImage
  ? new URL(articleSocialImage.src, "https://www.lifefocus.fr").toString()
  : undefined;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: article.title,
    description: article.description,
    datePublished: publishedAt,
    dateModified: updatedAt,
    author: {
      "@type": "Person",
      name: "Alexis Cosentino",
    },
    publisher: {
      "@type": "Organization",
      name: "Life Focus",
      url: "https://www.lifefocus.fr/",
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonicalUrl,
    },
    ...(articleSocialImageUrl ? { image: articleSocialImageUrl } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Accueil",
        item: "https://www.lifefocus.fr/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Conseils",
        item: "https://www.lifefocus.fr/conseils/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.title,
        item: canonicalUrl,
      },
    ],
  },
];
---

<BaseLayout
  title={article.seoTitle ?? `${article.title} | Life Focus`}
  description={article.description}
  canonicalUrl={canonicalUrl}
  ogImage={articleSocialImageUrl}
  ogType="article"
  structuredData={structuredData}
>
  <article class="article-page">
    <header class="article-hero page-shell">
      <nav class="article-breadcrumb" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a>
        <span aria-hidden="true">/</span>
        <a href="/conseils/">Conseils</a>
        <span aria-hidden="true">/</span>
        <span>{article.category}</span>
      </nav>

      <div class="article-hero__text">
        <p class="editorial-label">{article.category}</p>
        <h1>{article.title}</h1>
        <p>{article.excerpt}</p>
        <time datetime={article.publishedAt.toISOString()}>
          Publié le {article.publishedAt.toLocaleDateString("fr-FR")}
        </time>
      </div>

      <figure class="article-hero__image">
        <ImageSlot path={`src/images/conseils/${article.slug}.jpg`} orientation="horizontal" />
      </figure>
    </header>

    <div class="article-body page-shell">
      <div class="article-body__content">
        <slot />
      </div>
    </div>

    <footer class="article-next page-shell">
      <p class="editorial-label">POUR ALLER PLUS LOIN</p>
      <a class="editorial-link" href="/mariage/">DÉCOUVRIR LE MARIAGE →</a>
      <a class="editorial-link" href="/contact/">POSER UNE QUESTION →</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .article-page {
    overflow-x: clip;
  }

  .article-hero {
    display: grid;
    gap: var(--space-md);
    max-width: 84rem;
    padding-block: clamp(0.75rem, 1.8vw, 1.5rem) var(--space-lg);
  }

  .article-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.7rem;
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.07em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .article-breadcrumb a {
    color: var(--color-text);
    text-decoration: none;
  }

  .article-breadcrumb a:hover {
    color: var(--color-muted);
  }

  .article-hero__text {
    display: grid;
    gap: var(--space-xs);
    max-width: 58rem;
    min-width: 0;
  }

  .article-hero h1,
  .article-body__content :global(h2),
  .article-body__content :global(h3) {
    font-family: var(--font-editorial);
    font-weight: 400;
    letter-spacing: 0;
  }

  .article-hero h1 {
    max-width: 14ch;
    font-size: clamp(3.15rem, 1.75rem + 4.7vw, 7rem);
    line-height: 0.96;
    text-wrap: balance;
  }

  .article-hero__text > p:not(.editorial-label),
  .article-hero time {
    max-width: var(--reading-max);
    color: var(--color-muted);
  }

  .article-hero time {
    font-size: var(--text-sm);
  }

  .article-hero__image {
    width: 100%;
    margin: 0;
    background: var(--color-line);
  }

  .article-hero__image :global(img),
  .article-body__content :global(img) {
    width: 100%;
    height: auto;
  }

  .article-body {
    max-width: 84rem;
    padding-block: 0 var(--space-lg);
  }

  .article-body__content {
    display: grid;
    gap: 1.35rem;
    max-width: var(--reading-max);
    color: var(--color-text);
    font-size: clamp(1.06rem, 1rem + 0.18vw, 1.18rem);
    line-height: 1.78;
  }

  .article-body__content :global(h2) {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    font-size: clamp(2rem, 1.35rem + 2vw, 3.4rem);
    line-height: 1.02;
  }

  .article-body__content :global(h3) {
    margin-top: 1rem;
    font-size: clamp(1.45rem, 1.2rem + 0.9vw, 2.2rem);
    line-height: 1.08;
  }

  .article-body__content :global(p),
  .article-body__content :global(li) {
    color: var(--color-muted);
  }

  .article-body__content :global(a) {
    color: var(--color-text);
  }

  .article-body__content :global(ul),
  .article-body__content :global(ol) {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding-left: 1.2rem;
  }

  .article-body__content :global(blockquote) {
    display: grid;
    gap: 0.75rem;
    margin: clamp(1.5rem, 3vw, 2.5rem) 0;
    padding: 0 0 0 clamp(1rem, 2vw, 1.5rem);
    border-left: 1px solid var(--color-text);
  }

  .article-body__content :global(blockquote p) {
    color: var(--color-text);
  }

  .article-body__content :global(blockquote p:first-child) {
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .article-next {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    align-items: center;
    max-width: 84rem;
    padding-block: var(--space-md) var(--space-lg);
    border-top: 1px solid var(--color-line);
  }

  .article-next .editorial-label {
    width: 100%;
  }

  @media (min-width: 72rem) {
    .article-hero__text {
      margin-left: clamp(6rem, 12vw, 14rem);
    }

    .article-hero__image {
      width: min(86vw, 78rem);
      margin-inline: auto;
    }

    .article-body__content {
      margin-left: clamp(6rem, 12vw, 14rem);
    }

    .article-next {
      padding-left: clamp(6rem, 12vw, 14rem);
    }
  }
</style>

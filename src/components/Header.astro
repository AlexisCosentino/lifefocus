---
import logoLifeFocus from "../assets/brand/LIFE FOCUS logo.svg?url";

const familyItems = [
  { number: "01", label: "Grossesse", href: "/grossesse/" },
  { number: "02", label: "Naissance", href: "/naissance/" },
  { number: "03", label: "Famille", href: "/famille/" },
];

const clientArea = {
  label: "Espace client \u2197",
  href: "https://alexis-cosentino.lumys.photo/",
};
---

<header class="site-header">
  <div class="site-header__inner page-shell">
    <a class="site-identity" href="/" aria-label="Life Focus, accueil">
      <img
        class="site-identity__logo"
        src={logoLifeFocus}
        alt="Life Focus"
        width="1672"
        height="941"
        loading="eager"
        decoding="sync"
      />
    </a>

    <nav class="site-nav" aria-label="Navigation principale">
      <a href="/mariage/">Mariage</a>
      <details class="site-nav__group">
        <summary class="site-nav__summary">Famille</summary>
        <div class="site-nav__panel" aria-label="Choisir une séance famille">
          {familyItems.map((item) => (
            <a class="site-nav__panel-link" href={item.href}>
              <span>{item.number}</span>
              <strong>{item.label}</strong>
            </a>
          ))}
        </div>
      </details>
      <a href="/a-propos/">À propos</a>
      <a href="/conseils/">Conseils</a>
      <a href="/contact/">Contact</a>
      <a
        class="site-nav__utility"
        href={clientArea.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        {clientArea.label}
      </a>
    </nav>

    <details class="site-menu">
      <summary class="site-menu__summary">Menu</summary>
      <nav class="site-menu__panel" aria-label="Navigation mobile">
        <a href="/mariage/">Mariage</a>
        <details class="site-menu__group">
          <summary>Famille</summary>
          <div class="site-menu__family">
            {familyItems.map((item) => (
              <a href={item.href}>
                <span>{item.number}</span>
                <strong>{item.label}</strong>
              </a>
            ))}
          </div>
        </details>
        <a href="/a-propos/">À propos</a>
        <a href="/conseils/">Conseils</a>
        <a href="/contact/">Contact</a>
        <a
          class="site-menu__utility"
          href={clientArea.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          {clientArea.label}
        </a>
      </nav>
    </details>
  </div>
</header>

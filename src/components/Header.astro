---
import { Image } from "astro:assets";
import logoBlack from "../assets/brand/logo_life_focus_black.png";

const familyItems = [
  { label: "GROSSESSE", href: "/grossesse/" },
  { label: "NAISSANCE", href: "/naissance/" },
  { label: "FAMILLE", href: "/famille/" },
];

const secondaryNavItems = [
  { label: "À PROPOS", href: "/a-propos/" },
  { label: "CONTACT", href: "/contact/" },
];
---

<header class="site-header">
  <div class="site-header__inner page-shell">
    <a class="site-identity" href="/" aria-label="Life Focus, accueil">
      <Image
        class="site-identity__logo"
        src={logoBlack}
        alt="Life Focus"
        width={150}
        loading="eager"
        decoding="sync"
      />
    </a>

    <nav class="site-nav" aria-label="Navigation principale">
      <a href="/mariage/">MARIAGE</a>
      <details class="site-nav__group">
        <summary class="site-nav__summary">FAMILLE</summary>
        <div class="site-nav__submenu">
          {familyItems.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </details>
      {secondaryNavItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <details class="site-menu">
      <summary class="site-menu__summary">MENU</summary>
      <nav class="site-menu__panel" aria-label="Navigation mobile">
        <a href="/mariage/">MARIAGE</a>
        <details class="site-menu__group">
          <summary>FAMILLE</summary>
          <div>
            {familyItems.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
        </details>
        {secondaryNavItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>

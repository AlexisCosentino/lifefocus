---
import type { FamilyServiceImage } from "../data/familyServices";

import EditorialGallery from "./EditorialGallery.astro";

interface Props {
  images: FamilyServiceImage[];
  galleryFolder?: string;
}

const { images, galleryFolder } = Astro.props;
---

<EditorialGallery
  eyebrow="03 / GALERIE"
  title="Une première respiration visuelle."
  titleId="family-gallery-title"
  images={images}
  galleryFolder={galleryFolder}
/>

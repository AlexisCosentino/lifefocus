---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  path: string;
  orientation?: "horizontal" | "vertical" | "square";
  label?: string;
  loading?: "eager" | "lazy";
  sizes?: string;
  quality?: number;
}

const {
  path,
  orientation = "horizontal",
  label = "Photo attendue",
  loading = "lazy",
  sizes = "(min-width: 90rem) 70vw, (min-width: 64rem) 62vw, calc(100vw - (2 * var(--page-padding)))",
  quality = 82,
} = Astro.props;
const imageModules = import.meta.glob<{ default: ImageMetadata }>("/src/images/**/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}", {
  eager: true,
});
const image = imageModules[`/${path}`]?.default;
const isHeroCandidate = orientation === "horizontal" && (loading === "eager" || quality >= 90);
const widths = orientation === "vertical" ? [480, 720, 960, 1200] : isHeroCandidate ? [960, 1280, 1600, 1920, 2400] : [640, 960, 1280, 1600];
const pictureQuality = isHeroCandidate ? Math.min(quality, 86) : Math.min(quality, 82);
---

{
  image ? (
    <Picture
      src={image}
      alt={label}
      widths={widths}
      sizes={sizes}
      formats={["avif"]}
      fallbackFormat="webp"
      quality={pictureQuality}
      loading={loading}
    />
  ) : (
    <div
      class:list={["image-slot", `image-slot--${orientation}`]}
      role="img"
      aria-label={`${label} : ${path}`}
    >
      <span>{label}</span>
      <code>{path}</code>
    </div>
  )
}

<style>
  .image-slot {
    display: grid;
    gap: 0.55rem;
    place-content: center;
    width: 100%;
    min-height: 9rem;
    padding: clamp(1rem, 2vw, 1.6rem);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--color-text) 7%, transparent) 1px, transparent 1px),
      linear-gradient(color-mix(in srgb, var(--color-text) 7%, transparent) 1px, transparent 1px),
      var(--color-line);
    background-size: 2rem 2rem;
    color: var(--color-muted);
    text-align: center;
    overflow-wrap: anywhere;
  }

  .image-slot--horizontal {
    aspect-ratio: 3 / 2;
  }

  .image-slot--vertical {
    aspect-ratio: 2 / 3;
  }

  .image-slot--square {
    aspect-ratio: 1;
  }

  .image-slot span {
    color: var(--color-text);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .image-slot code {
    font-family: var(--font-interface);
    font-size: clamp(0.78rem, 0.72rem + 0.2vw, 0.95rem);
    line-height: 1.45;
  }
</style>

---
import type { ImageMetadata } from "astro";

import EditorialGallery from "./EditorialGallery.astro";

interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  size: "wide" | "vertical" | "small";
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

<EditorialGallery
  eyebrow="09 / GALERIE"
  title="Quelques fragments pour sentir le rythme."
  titleId="gallery-title"
  images={images}
/>

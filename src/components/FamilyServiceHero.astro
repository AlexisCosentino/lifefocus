---
import type { FamilyServiceImage } from "../data/familyServices";
import ImageSlot from "./ImageSlot.astro";

interface Props {
  eyebrow: string;
  title: string;
  text: string;
  image: FamilyServiceImage;
  secondaryImage: FamilyServiceImage;
}

const { eyebrow, title, text, image, secondaryImage } = Astro.props;
---

<section class="family-service-hero" aria-labelledby="family-service-title">
  <div class="family-service-hero__visuals">
    <figure class="family-service-hero__image family-service-hero__image--main">
      <ImageSlot
        path={image.slotPath ?? "src/images/service/hero-main.jpg"}
        orientation={image.slotOrientation ?? "horizontal"}
        loading="eager"
        quality={92}
        sizes="(min-width: 72rem) 58vw, calc(100vw - (2 * var(--page-padding)))"
      />
    </figure>

    <figure class="family-service-hero__image family-service-hero__image--secondary">
      <ImageSlot
        path={secondaryImage.slotPath ?? "src/images/service/hero-secondary.jpg"}
        orientation={secondaryImage.slotOrientation ?? "vertical"}
        loading="eager"
        quality={92}
        sizes="(min-width: 72rem) 20vw, 48vw"
      />
    </figure>
  </div>

  <div class="family-service-hero__text">
    <p class="editorial-label">{eyebrow}</p>
    <h1 id="family-service-title">{title}</h1>
    <p>{text}</p>
  </div>
</section>

<style>
  .family-service-hero {
    display: grid;
    align-items: start;
    width: min(92vw, 82rem);
    margin-inline: auto;
    padding-block: clamp(0.75rem, 1.8vw, 1.5rem) clamp(4.5rem, 7vw, 6.5rem);
    isolation: isolate;
    min-width: 0;
  }

  .family-service-hero__visuals {
    position: relative;
    z-index: 1;
    display: grid;
    align-items: end;
    isolation: isolate;
    min-width: 0;
  }

  .family-service-hero__image {
    position: relative;
    width: 100%;
    margin: 0;
    background: var(--color-line);
  }

  .family-service-hero__image--main {
    z-index: 1;
  }

  .family-service-hero__image--secondary {
    z-index: 2;
    width: min(48vw, 15rem);
    margin-top: calc(var(--space-sm) * -1);
    margin-left: auto;
  }

  .family-service-hero__image :global(img) {
    width: 100%;
    height: auto;
  }

  .family-service-hero__text {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0.85rem;
    width: min(100%, 37rem);
    margin-top: clamp(-3.4rem, -8vw, -1.8rem);
    margin-left: auto;
    padding: clamp(1.35rem, 2.35vw, 2.35rem);
    background: var(--color-surface-soft);
    min-width: 0;
    overflow-wrap: break-word;
  }

  .family-service-hero h1 {
    max-width: 12ch;
    font-family: var(--font-editorial);
    font-size: clamp(2.55rem, 1.55rem + 3.15vw, 4.85rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 0.94;
    overflow-wrap: break-word;
  }

  .family-service-hero__text > p:not(.editorial-label) {
    max-width: var(--reading-max);
    color: var(--color-muted);
  }

  @media (min-width: 72rem) {
    .family-service-hero {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      padding-bottom: clamp(5.5rem, 8vw, 7.5rem);
    }

    .family-service-hero__visuals {
      grid-column: 4 / 13;
      grid-row: 1;
      grid-template-columns: repeat(10, minmax(0, 1fr));
      align-items: start;
      justify-self: end;
      width: min(64vw, 54rem);
    }

    .family-service-hero__image--main {
      grid-column: 1 / 9;
      grid-row: 1;
    }

    .family-service-hero__image--secondary {
      grid-column: 8 / 11;
      grid-row: 1;
      align-self: start;
      width: 100%;
      margin: 0 0 0 calc(var(--space-sm) * -0.55);
      transform: translateY(clamp(-4rem, -5vw, -2.75rem));
    }

    .family-service-hero__text {
      grid-column: 1 / 6;
      grid-row: 1;
      align-self: start;
      margin-top: clamp(2rem, 4.5vw, 3.75rem);
      margin-right: 0;
      margin-left: 0;
    }
  }
</style>

---
import { Image } from "astro:assets";
import logoBlack from "../assets/brand/logo_life_focus_black.png";
---

<footer class="site-footer">
  <div class="site-footer__inner page-shell">
    <Image
      class="site-footer__brand"
      src={logoBlack}
      alt="Life Focus"
      width={150}
      loading="lazy"
    />

    <div class="site-footer__content">
      <div class="site-footer__meta">
        <p>Photographe de mariage</p>
        <p>Romans-sur-Isère · Drôme</p>
      </div>

      <nav class="site-footer__links" aria-label="Liens de pied de page">
        <a href="https://www.instagram.com/" rel="noreferrer">Instagram</a>
        <a href="/contact/">Contact</a>
        <a href="/mentions-legales/">Mentions légales</a>
      </nav>
    </div>
  </div>
</footer>

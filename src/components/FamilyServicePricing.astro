---
import type { FamilyServiceImage, FamilyServicePackage, FamilyServicePricingTexts } from "../data/familyServices";
import ImageSlot from "./ImageSlot.astro";

interface Props {
  package?: FamilyServicePackage;
  pricing?: FamilyServicePricingTexts;
  image?: FamilyServiceImage;
}

const { package: combinedPackage, pricing, image } = Astro.props;
const isSessionLayout = pricing?.layout === "sessions";
const hasNumberedIncluded = pricing?.includedStyle === "numbered";

const included = [
  "Séance photo de 45 min à 1 h, selon le rythme du moment.",
  "Toutes les photos livrées sont traitées et retouchées naturellement.",
  "Pack photo HD au format numérique, sans limite de photos.",
  "Déplacement jusqu'à 30 km autour de Romans-sur-Isère.",
  "Livraison des photos numériques sous 1 semaine maximum.",
];

const formulas = [
  {
    duration: "01 H",
    sessionCount: pricing?.formula.sessionCount ?? "01",
    sessionUnit: pricing?.formula.sessionUnit ?? "séance",
    typeLabel: pricing?.formula.typeLabel ?? "Séance photo",
    durationLabel: pricing?.formula.durationLabel ?? "≈ 1 heure",
    name: "Séance photo",
    context:
      pricing?.formula.context ??
      "Portrait solo, couple, grossesse, naissance ou famille, en intérieur ou en extérieur.",
    price: "250 €",
    details: pricing?.formula.details ?? [
      "Photos livrées sans limite de nombre.",
      "Moment guidé simplement, sans mise en scène lourde.",
    ],
  },
  ...(combinedPackage
    ? [
        {
          duration: "02 SÉANCES",
          sessionCount: pricing?.combined?.sessionCount ?? "02",
          sessionUnit: pricing?.combined?.sessionUnit ?? "séances",
          typeLabel: pricing?.combined?.typeLabel ?? combinedPackage.title,
          durationLabel: pricing?.combined?.durationLabel ?? "2 × ≈ 1 heure",
          name: combinedPackage.title,
          context: isSessionLayout ? "" : combinedPackage.text,
          price: combinedPackage.price,
          details: pricing?.combined?.details ?? [
            "Une continuité entre l'attente et les premiers jours.",
            "Deux séances d'1 h.",
          ],
          href: combinedPackage.href,
          linkLabel: combinedPackage.linkLabel,
        },
      ]
    : []),
];
---

<section
  class={`family-service-pricing page-shell${isSessionLayout ? " family-service-pricing--sessions" : ""}${hasNumberedIncluded ? " family-service-pricing--numbered-included" : ""}`}
  aria-labelledby="family-pricing-title"
>
  <div class="family-service-pricing__intro">
    <p class="editorial-label">02 / TARIF</p>
    <h2 id="family-pricing-title">Une formule simple, sans limite de photos.</h2>
    {
      image?.slotPath && (
        <figure class="family-service-pricing__intro-image">
          <ImageSlot
            path={image.slotPath}
            orientation={image.slotOrientation ?? "vertical"}
            label={image.alt ?? ""}
            sizes="(min-width: 72rem) 18rem, 42vw"
          />
        </figure>
      )
    }
  </div>

  <div class="family-service-pricing__content">
    <section class="family-service-pricing__included" aria-labelledby="family-included-title">
      <p id="family-included-title" class="family-service-pricing__eyebrow">Inclus dans chaque séance</p>
      <ul>
        {
          (pricing?.included ?? included).map((item) => (
            <li>{item}</li>
          ))
        }
      </ul>
    </section>

    <section class="family-service-pricing__formulas" aria-labelledby="family-formulas-title">
      <p id="family-formulas-title" class="family-service-pricing__eyebrow">Choisir sa formule</p>

      {
        isSessionLayout ? (
          <ol class="family-service-pricing__session-list">
            {
              formulas.map((item) => (
                <li>
                  <p class="family-service-pricing__session-count">
                    <span>{item.sessionCount}</span>
                    <span>{item.sessionUnit}</span>
                  </p>

                  <h3>{item.typeLabel}</h3>

                  <div class="family-service-pricing__session-meta">
                    <p>{item.durationLabel}</p>
                    <p>{item.price}</p>
                  </div>

                  {(item.context || item.details.length > 0 || ("href" in item && item.href && item.linkLabel)) && (
                    <div class="family-service-pricing__session-copy">
                      {item.context && <p>{item.context}</p>}
                      {item.details.map((detail) => (
                        <p>{detail}</p>
                      ))}
                      {"href" in item && item.href && item.linkLabel && (
                        <a class="editorial-link" href={item.href}>{item.linkLabel}</a>
                      )}
                    </div>
                  )}
                </li>
              ))
            }
          </ol>
        ) : (
          <ol>
            {
              formulas.map((item) => (
                <li>
                  <p class="family-service-pricing__duration">{item.duration}</p>

                  <div class="family-service-pricing__details">
                    <h3>{item.name}</h3>
                    {!hasNumberedIncluded && <p>{item.context}</p>}
                  </div>

                  <div class="family-service-pricing__price">
                    <p>{item.price}</p>
                    {hasNumberedIncluded
                      ? "href" in item && item.href && item.context && <p>{item.context}</p>
                      : item.details.map((detail) => (
                          <p>{detail}</p>
                        ))}
                    {"href" in item && item.href && item.linkLabel && (
                      <a class="editorial-link" href={item.href}>{item.linkLabel}</a>
                    )}
                  </div>
                </li>
              ))
            }
          </ol>
        )
      }
    </section>
  </div>
</section>

<style>
  .family-service-pricing {
    display: grid;
    gap: var(--space-md);
    max-width: 82rem;
    padding-block: var(--space-lg);
  }

  .family-service-pricing__intro {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
  }

  .family-service-pricing h2 {
    max-width: 12ch;
    font-family: var(--font-editorial);
    font-size: clamp(2.45rem, 1.55rem + 3vw, 5rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .family-service-pricing__intro-image {
    display: none;
    width: min(14rem, 68%);
    margin-top: clamp(0.9rem, 2vw, 1.4rem);
    overflow: hidden;
    aspect-ratio: 2 / 3;
  }

  .family-service-pricing__intro-image :global(img),
  .family-service-pricing__intro-image :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .family-service-pricing__intro-image :global(img) {
    object-fit: cover;
  }

  .family-service-pricing__content,
  .family-service-pricing__included,
  .family-service-pricing__formulas {
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
  }

  .family-service-pricing__eyebrow,
  .family-service-pricing__duration {
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .family-service-pricing__included {
    align-content: start;
    padding-block: clamp(1.35rem, 2.5vw, 2rem);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .family-service-pricing__included ul {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .family-service-pricing__included li {
    position: relative;
    padding-left: 1.35rem;
    color: var(--color-text);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .family-service-pricing__included li::before {
    position: absolute;
    top: 0.74em;
    left: 0;
    width: 0.45rem;
    height: 1px;
    background: currentColor;
    content: "";
  }

  .family-service-pricing__formulas ol {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
    list-style: none;
  }

  .family-service-pricing__formulas li {
    display: grid;
    gap: var(--space-xs);
    padding-block: clamp(1.6rem, 3vw, 2.35rem);
    border-bottom: 1px solid var(--color-line);
  }

  .family-service-pricing__details {
    display: grid;
    gap: 0.65rem;
  }

  .family-service-pricing__details h3 {
    font-family: var(--font-editorial);
    font-size: clamp(2rem, 1.3rem + 2.2vw, 3.5rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .family-service-pricing__details p,
  .family-service-pricing__price p:not(:first-child) {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .family-service-pricing__price {
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }

  .family-service-pricing__price p:first-child {
    font-family: var(--font-editorial);
    font-size: clamp(2.55rem, 1.7rem + 2.8vw, 4.4rem);
    font-weight: 400;
    line-height: 0.95;
    white-space: nowrap;
  }

  .family-service-pricing__price .editorial-link {
    width: fit-content;
    margin-top: 0.3rem;
  }

  .family-service-pricing--numbered-included .family-service-pricing__included ul {
    gap: 0;
    counter-reset: included;
    border-top: 1px solid var(--color-line);
  }

  .family-service-pricing--numbered-included .family-service-pricing__included {
    padding-block: 0;
    border: 0;
  }

  .family-service-pricing--numbered-included .family-service-pricing__included li {
    counter-increment: included;
    display: grid;
    grid-template-columns: clamp(2.8rem, 6vw, 3.9rem) minmax(0, 1fr);
    gap: clamp(0.95rem, 2vw, 1.35rem);
    align-items: center;
    padding-block: clamp(0.85rem, 1.45vw, 1.05rem);
    border-bottom: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: clamp(0.94rem, 0.9rem + 0.16vw, 1.02rem);
    line-height: 1.35;
  }

  .family-service-pricing--numbered-included .family-service-pricing__included li::before {
    position: static;
    width: auto;
    height: auto;
    background: transparent;
    color: var(--color-text);
    content: counter(included, decimal-leading-zero);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  .family-service-pricing__session-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
    list-style: none;
  }

  .family-service-pricing__session-list li {
    display: grid;
    gap: 0;
    padding-block: clamp(1.15rem, 2vw, 1.6rem);
    border-bottom: 1px solid var(--color-line);
  }

  .family-service-pricing__session-count {
    display: flex;
    gap: clamp(0.4rem, 1.1vw, 0.7rem);
    align-items: flex-start;
    margin-bottom: clamp(0.55rem, 1.2vw, 0.9rem);
    color: var(--color-text);
    line-height: 0.86;
  }

  .family-service-pricing__session-count span:first-child {
    font-family: var(--font-editorial);
    font-size: clamp(4.2rem, 18vw, 7.6rem);
    font-weight: 400;
    letter-spacing: 0;
  }

  .family-service-pricing__session-count span:last-child {
    padding-top: clamp(0.38rem, 1.9vw, 0.68rem);
    color: color-mix(in srgb, var(--color-text) 86%, var(--color-muted));
    font-family: var(--font-body);
    font-size: clamp(0.78rem, 0.72rem + 0.22vw, 0.96rem);
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
  }

  .family-service-pricing__session-list h3 {
    margin-bottom: clamp(0.65rem, 1.2vw, 0.95rem);
    font-family: var(--font-body);
    font-size: clamp(1.2rem, 1.02rem + 0.45vw, 1.55rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .family-service-pricing__session-meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(0.45rem, 0.9vw, 0.7rem);
    max-width: 18rem;
  }

  .family-service-pricing__session-meta p:first-child {
    color: var(--color-text);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .family-service-pricing__session-meta p:last-child {
    color: var(--color-text);
    font-family: var(--font-editorial);
    font-size: clamp(1.8rem, 1.35rem + 1.1vw, 2.65rem);
    line-height: 0.95;
    white-space: nowrap;
  }

  .family-service-pricing__session-copy {
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }

  .family-service-pricing__session-copy p {
    max-width: 36rem;
    color: var(--color-muted);
    font-size: clamp(0.95rem, 0.9rem + 0.16vw, 1.04rem);
    line-height: 1.5;
  }

  .family-service-pricing__session-copy .editorial-link {
    width: fit-content;
    margin-top: clamp(0.8rem, 1.5vw, 1.1rem);
    font-size: var(--text-xs);
  }

  @media (min-width: 72rem) {
    .family-service-pricing {
      grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    }

    .family-service-pricing__intro-image {
      display: block;
    }

    .family-service-pricing__content {
      align-self: start;
    }

    .family-service-pricing__formulas li {
      grid-template-columns: minmax(4.5rem, 0.22fr) minmax(0, 1fr) minmax(9rem, 0.45fr);
      gap: clamp(1.25rem, 3vw, 3rem);
      align-items: start;
    }

    .family-service-pricing__session-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(4rem, 8vw, 7rem);
    }

    .family-service-pricing__session-list li {
      grid-template-columns: none;
      grid-template-rows: none;
      padding-block: clamp(1.25rem, 2vw, 1.65rem);
    }

    .family-service-pricing__session-count span:first-child {
      font-size: clamp(5.4rem, 8vw, 8rem);
    }
  }
</style>

---
import type { FamilyServicePackage } from "../data/familyServices";

interface Props {
  package?: FamilyServicePackage;
}

const { package: combinedPackage } = Astro.props;
---

<section class="family-service-pricing page-shell" aria-labelledby="family-pricing-title">
  <div class="family-service-pricing__intro">
    <p class="editorial-label">02 / TARIF</p>
    <h2 id="family-pricing-title">Une formule claire.</h2>
  </div>

  <div class="family-service-pricing__list">
    <section class="family-service-pricing__item">
      <div>
        <p>1 HEURE</p>
        <strong>250 €</strong>
      </div>
      <span>Sans limite de photos livrées</span>
    </section>

    {
      combinedPackage && (
        <section class="family-service-pricing__item family-service-pricing__item--package">
          <div>
            <p>{combinedPackage.title}</p>
            <strong>{combinedPackage.price}</strong>
          </div>
          <span>{combinedPackage.text}</span>
          {combinedPackage.href && combinedPackage.linkLabel && (
            <a class="editorial-link" href={combinedPackage.href}>{combinedPackage.linkLabel}</a>
          )}
        </section>
      )
    }
  </div>
</section>

<style>
  .family-service-pricing {
    display: grid;
    gap: var(--space-md);
    max-width: 76rem;
    padding-block: var(--space-lg);
  }

  .family-service-pricing__intro {
    display: grid;
    gap: var(--space-xs);
  }

  .family-service-pricing h2 {
    max-width: 11ch;
    font-family: var(--font-editorial);
    font-size: clamp(2.45rem, 1.55rem + 3vw, 5rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .family-service-pricing__list {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-line);
  }

  .family-service-pricing__item {
    display: grid;
    gap: var(--space-xs);
    padding-block: clamp(1.6rem, 3vw, 2.4rem);
    border-bottom: 1px solid var(--color-line);
  }

  .family-service-pricing__item div {
    display: grid;
    gap: 0.35rem;
  }

  .family-service-pricing__item p,
  .family-service-pricing__item span {
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .family-service-pricing__item span {
    max-width: var(--reading-max);
    text-transform: none;
    letter-spacing: 0;
    font-size: var(--text-sm);
    font-weight: 400;
  }

  .family-service-pricing__item strong {
    font-family: var(--font-editorial);
    font-size: clamp(3.2rem, 1.8rem + 4vw, 5.8rem);
    font-weight: 400;
    line-height: 0.95;
  }

  .family-service-pricing__item .editorial-link {
    width: fit-content;
    margin-top: 0.5rem;
  }

  @media (min-width: 72rem) {
    .family-service-pricing {
      grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    }

    .family-service-pricing__list {
      align-self: start;
    }
  }
</style>

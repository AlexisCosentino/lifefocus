---
import type { FamilyServicePageData } from "../data/familyServices";
import DecorativeSectionNumber from "./DecorativeSectionNumber.astro";
import FamilyServiceFAQ from "./FamilyServiceFAQ.astro";
import FamilyServiceGallery from "./FamilyServiceGallery.astro";
import FamilyServiceHero from "./FamilyServiceHero.astro";
import FamilyServiceLinks from "./FamilyServiceLinks.astro";
import FamilyServicePricing from "./FamilyServicePricing.astro";
import ImageSlot from "./ImageSlot.astro";

interface Props {
  service: FamilyServicePageData;
}

const { service } = Astro.props;
const serviceSlugs = {
  Grossesse: "grossesse",
  Naissance: "naissance",
  Famille: "famille",
} as const;
const serviceSlug = serviceSlugs[service.label as keyof typeof serviceSlugs] ?? "service";
const approachNumber = service.approach.label.match(/^\d+/)?.[0];
const approachNumberPlacements = {
  grossesse: "right",
  naissance: "left",
  famille: "center",
  service: "right",
} as const;
const approachNumberPlacement = approachNumberPlacements[serviceSlug as keyof typeof approachNumberPlacements] ?? "right";
const galleryImages = service.gallery.map((image, index) => ({
  ...image,
  slotPath: image.slotPath ?? `src/images/${serviceSlug}/gallery/${String(index + 1).padStart(2, "0")}.jpg`,
}));
---

<div class="family-service-page">
  <FamilyServiceHero
    eyebrow={service.hero.eyebrow}
    title={service.hero.title}
    text={service.hero.text}
    image={{
      ...service.hero.image,
      slotPath: service.hero.image.slotPath ?? `src/images/${serviceSlug}/hero-main.jpg`,
      slotOrientation: service.hero.image.slotOrientation ?? "horizontal",
    }}
    secondaryImage={{
      ...service.hero.secondaryImage,
      slotPath: service.hero.secondaryImage.slotPath ?? `src/images/${serviceSlug}/hero-secondary.jpg`,
      slotOrientation: service.hero.secondaryImage.slotOrientation ?? "vertical",
    }}
  />

  <section
    class:list={[
      "family-service-approach",
      "page-shell",
      "decorative-section-number-frame",
      `family-service-approach--${serviceSlug}`,
    ]}
    aria-labelledby="family-approach-title"
  >
    {approachNumber && <DecorativeSectionNumber value={approachNumber} placement={approachNumberPlacement} />}
    <div class="family-service-approach__text decorative-section-number-content">
      <p class="editorial-label">{service.approach.label}</p>
      <h2 id="family-approach-title">{service.approach.title}</h2>
      <p>{service.approach.text}</p>
    </div>

    <figure class="family-service-approach__image decorative-section-number-content">
      <ImageSlot
        path={service.approach.image.slotPath ?? `src/images/${serviceSlug}/approach-main.jpg`}
        orientation={service.approach.image.slotOrientation ?? "horizontal"}
        label={service.approach.image.alt ?? ""}
      />
    </figure>
  </section>

  {
    service.editorialBlock && (
      <section class="family-service-editorial page-shell" aria-labelledby="family-editorial-title">
        <p class="editorial-label">{service.editorialBlock.label}</p>
        <h2 id="family-editorial-title">{service.editorialBlock.title}</h2>
        <p>{service.editorialBlock.text}</p>
      </section>
    )
  }

  {
    service.adviceBlock && (
      <section class="family-service-advice page-shell" aria-labelledby="family-advice-title">
        <div class="family-service-advice__heading">
          <p class="editorial-label">{service.adviceBlock.label}</p>
          <h2 id="family-advice-title">{service.adviceBlock.title}</h2>
        </div>

        <div class="family-service-advice__content">
          <p>{service.adviceBlock.text}</p>
          <a class="editorial-link" href={service.adviceBlock.href}>{service.adviceBlock.linkLabel}</a>
        </div>
      </section>
    )
  }

  <FamilyServicePricing package={service.package} pricing={service.pricing} />
  <FamilyServiceGallery images={galleryImages} galleryFolder={`src/images/${serviceSlug}/gallery`} />
  <FamilyServiceLinks links={service.links} />
  <FamilyServiceFAQ items={service.faq} />

  <section class="family-service-contact page-shell" aria-labelledby="family-contact-title">
    <h2 id="family-contact-title">Votre histoire commence ici.</h2>
    <a class="editorial-link" href="/contact/">ÉCRIVEZ-MOI →</a>
  </section>
</div>

<style>
  .family-service-page :global(figure) {
    margin: 0;
  }

  .family-service-page :global(img) {
    width: 100%;
    height: auto;
  }

  .family-service-approach {
    --decorative-section-number-inline: clamp(0.55rem, 2vw, 1.6rem);
    --decorative-section-number-top: clamp(0.85rem, 2.8vw, 1.8rem);

    display: grid;
    gap: var(--space-md);
    align-items: end;
    max-width: 76rem;
    padding-block: var(--space-lg);
  }

  .family-service-approach--naissance {
    --decorative-section-number-inline: clamp(0.3rem, 1.5vw, 1.1rem);
  }

  .family-service-approach--famille {
    --decorative-section-number-center: 56%;
    --decorative-section-number-mobile-center: 64%;
  }

  .family-service-approach__text {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }

  .family-service-editorial {
    display: grid;
    gap: var(--space-xs);
    max-width: 76rem;
    padding-block: var(--space-md);
    border-top: 1px solid var(--color-line);
  }

  .family-service-advice {
    display: grid;
    gap: var(--space-sm);
    max-width: 76rem;
    padding-block: clamp(2.75rem, 5vw, 4.5rem);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .family-service-advice__heading,
  .family-service-advice__content {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }

  .family-service-approach h2,
  .family-service-editorial h2,
  .family-service-advice h2,
  .family-service-contact h2 {
    max-width: 12ch;
    font-family: var(--font-editorial);
    font-size: clamp(2.25rem, 1.45rem + 2.45vw, 4.25rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .family-service-approach p:not(.editorial-label),
  .family-service-editorial p:not(.editorial-label),
  .family-service-advice p:not(.editorial-label) {
    max-width: var(--reading-max);
    color: var(--color-muted);
  }

  .family-service-advice .editorial-link {
    width: fit-content;
  }

  .family-service-approach__image {
    width: 100%;
    background: var(--color-line);
  }

  .family-service-contact {
    display: grid;
    gap: var(--space-sm);
    align-content: center;
    max-width: 76rem;
    min-height: clamp(12rem, 18vw, 17rem);
    padding-block: clamp(4rem, 6vw, 6rem);
  }

  @media (min-width: 72rem) {
    .family-service-approach {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
      gap: clamp(3rem, 7vw, 7rem);
    }

    .family-service-contact {
      grid-template-columns: minmax(0, 0.55fr) minmax(0, 1fr);
    }

    .family-service-editorial {
      grid-template-columns: minmax(0, 0.48fr) minmax(0, 1fr);
      gap: var(--space-xs) clamp(3rem, 7vw, 7rem);
      align-items: start;
    }

    .family-service-editorial .editorial-label,
    .family-service-editorial h2 {
      grid-column: 1;
    }

    .family-service-editorial p {
      grid-column: 2;
    }

    .family-service-advice {
      grid-template-columns: minmax(0, 0.48fr) minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
    }

    .family-service-advice__content {
      padding-top: 0.15rem;
    }

    .family-service-contact h2,
    .family-service-contact a {
      grid-column: 2;
    }
  }
</style>

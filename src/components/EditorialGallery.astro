---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

import ImageSlot from "./ImageSlot.astro";

interface EditorialGalleryImage {
  src: ImageMetadata;
  alt: string;
  size?: "wide" | "vertical" | "portrait" | "small";
  slotPath?: string;
  slotOrientation?: "horizontal" | "vertical" | "square";
}

interface Props {
  eyebrow: string;
  title: string;
  titleId: string;
  images: EditorialGalleryImage[];
  galleryFolder?: string;
}

const { eyebrow, title, titleId, images, galleryFolder } = Astro.props;

const normalizeSize = (size: EditorialGalleryImage["size"]) => (size === "vertical" ? "portrait" : size ?? "small");

const imageModules = import.meta.glob<{ default: ImageMetadata }>("/src/images/**/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}", {
  eager: true,
});

const normalizedFolder = galleryFolder?.replace(/^\/?/, "/").replace(/\/$/, "");
const folderImages = normalizedFolder
  ? Object.entries(imageModules)
      .filter(([path]) => path.startsWith(`${normalizedFolder}/`))
      .sort(([pathA], [pathB]) => pathA.localeCompare(pathB, "fr", { numeric: true, sensitivity: "base" }))
      .map(([path, module], index) => ({
        resolvedSrc: module.default,
        alt: `${title} - image ${index + 1}`,
        slotPath: path.slice(1),
      }))
  : [];

const galleryImages = folderImages.length > 0 ? folderImages : images;

const getOrientation = (image: Pick<EditorialGalleryImage, "size" | "slotOrientation"> & { src?: ImageMetadata }) => {
  if (image.slotOrientation) {
    return image.slotOrientation;
  }

  if (image.src && image.src.height > image.src.width) {
    return "vertical";
  }

  return normalizeSize(image.size) === "portrait" ? "vertical" : "horizontal";
};
---

<section class="editorial-gallery" aria-labelledby={titleId}>
  <div class="editorial-gallery__intro page-shell">
    <p class="editorial-label">{eyebrow}</p>
    <h2 id={titleId}>{title}</h2>
  </div>

  <div class="editorial-gallery__grid">
    {
      galleryImages.map((image, index) => (
        <figure class:list={["editorial-gallery__item", `editorial-gallery__item--${normalizeSize(image.size)}`]}>
          {"resolvedSrc" in image ? (
            <Picture
              src={image.resolvedSrc}
              alt={image.alt}
              widths={[480, 768, 1080, 1440]}
              sizes="(min-width: 100rem) 18vw, (min-width: 64rem) 23vw, (min-width: 42rem) 46vw, calc(100vw - (2 * var(--page-padding)))"
              formats={["avif"]}
              fallbackFormat="webp"
              quality={82}
              loading="lazy"
            />
          ) : (
            <ImageSlot
              path={image.slotPath ?? `src/images/gallery/${String(index + 1).padStart(2, "0")}.jpg`}
              orientation={getOrientation(image)}
            />
          )}
        </figure>
      ))
    }
  </div>
</section>

<style>
  .editorial-gallery {
    width: 100%;
    padding-block: var(--space-lg);
    overflow: clip;
  }

  .editorial-gallery__intro {
    display: grid;
    gap: var(--space-xs);
    max-width: 76rem;
    margin-bottom: var(--space-md);
  }

  .editorial-gallery h2 {
    max-width: 12ch;
    font-family: var(--font-editorial);
    font-size: clamp(2.45rem, 1.55rem + 3vw, 5rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .editorial-gallery__grid {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding-inline: var(--page-padding);
    column-gap: clamp(1rem, 1.45vw, 1.75rem);
    columns: 1;
  }

  .editorial-gallery__item {
    display: inline-block;
    width: 100%;
    margin: 0 0 clamp(1rem, 1.45vw, 1.75rem);
    break-inside: avoid;
    background: var(--color-line);
  }

  .editorial-gallery__item :global(img) {
    width: 100%;
    height: auto;
  }

  @media (min-width: 42rem) {
    .editorial-gallery__grid {
      columns: 2;
    }

    .editorial-gallery__item:nth-child(4n + 2) {
      margin-top: var(--space-sm);
    }
  }

  @media (min-width: 64rem) {
    .editorial-gallery__grid {
      columns: 4;
    }

    .editorial-gallery__item:nth-child(4n + 2) {
      margin-top: 0;
    }

    .editorial-gallery__item:nth-child(8n + 2),
    .editorial-gallery__item:nth-child(8n + 7) {
      margin-top: var(--space-sm);
    }
  }

  @media (min-width: 100rem) {
    .editorial-gallery__grid {
      columns: 5;
    }
  }
</style>

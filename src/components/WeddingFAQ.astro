---
import { weddingFaq } from "../data/weddingFaq";
---

<section class="wedding-faq page-shell" aria-labelledby="faq-title">
  <div class="wedding-faq__intro">
    <p class="editorial-label">10 / QUESTIONS</p>
    <h2 id="faq-title">Avant de réserver.</h2>
  </div>

  <div class="wedding-faq__items">
    {
      weddingFaq.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>

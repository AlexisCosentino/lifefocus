---
import { weddingTrust } from "../data/weddingTrust";
const stars = [1, 2, 3, 4, 5];
const { lang = "fr", variant = "wedding" } = Astro.props as {
  lang?: "fr" | "en";
  variant?: "wedding" | "family";
};
const isEnglish = lang === "en";
---

<aside class="wedding-trust-signature" aria-label={isEnglish ? "Life Focus reviews and credentials" : variant === "family" ? "Expérience et avis Google Life Focus" : "Repères et avis Life Focus"}>
  <p class="wedding-trust-signature__line">{variant === "family" ? (isEnglish ? `Photographer since ${weddingTrust.experienceYear}.` : `Photographe depuis ${weddingTrust.experienceYear}.`) : isEnglish ? `Since ${weddingTrust.experienceYear}, by your side.` : `Depuis ${weddingTrust.experienceYear}, à vos côtés.`}</p>
  <ul class="wedding-trust-signature__groups">
    <li class="wedding-trust-signature__group">
      <a
        class="wedding-trust-signature__rating-link"
        href={weddingTrust.google.url}
        target="_blank"
        rel="noreferrer"
        aria-label={isEnglish ? `Life Focus Google reviews, rated ${weddingTrust.google.rating}. Open Google reviews.` : `Avis Google Life Focus, note moyenne ${weddingTrust.google.rating}. Ouvrir les avis Google.`}
      >
        <span class="wedding-trust-signature__platform">Google</span>
        <span class="wedding-trust-signature__rating">
          <span class="wedding-trust-signature__stars" aria-hidden="true">
            {stars.map(() => (
              <svg viewBox="0 0 16 16" focusable="false"><path d="m8 1.45 1.9 3.86 4.26.62-3.08 3 .73 4.24L8 11.17l-3.81 2 .73-4.24-3.08-3 4.26-.62L8 1.45Z" /></svg>
            ))}
          </span>
          <strong>{weddingTrust.google.rating}</strong>
        </span>
      </a>
    </li>
    {variant === "wedding" && (
      <>
        <li class="wedding-trust-signature__group">
          <a class="wedding-trust-signature__rating-link" href={weddingTrust.mariagesNet.url} target="_blank" rel="nofollow noopener noreferrer"
            aria-label={isEnglish ? `Life Focus Mariages.net reviews, rated ${weddingTrust.mariagesNet.rating}. Open Mariages.net reviews.` : `Avis Mariages.net Life Focus, note moyenne ${weddingTrust.mariagesNet.rating}. Ouvrir les avis Mariages.net.`}>
            <span class="wedding-trust-signature__platform">Mariages.net</span>
            <span class="wedding-trust-signature__rating">
              <span class="wedding-trust-signature__stars" aria-hidden="true">{stars.map(() => <svg viewBox="0 0 16 16" focusable="false"><path d="m8 1.45 1.9 3.86 4.26.62-3.08 3 .73 4.24L8 11.17l-3.81 2 .73-4.24-3.08-3 4.26-.62L8 1.45Z" /></svg>)}</span>
              <strong>{weddingTrust.mariagesNet.rating}</strong>
            </span>
          </a>
        </li>
        <li class="wedding-trust-signature__group wedding-trust-signature__awards">
          <span class="wedding-trust-signature__laurel-wrap">
            <svg class="wedding-trust-signature__laurel" viewBox="0 0 52 54" aria-hidden="true" focusable="false">
              <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.15">
                <path d="M19 46C10 39 7 29 9 17M33 46c9-7 12-17 10-29" />
                <path d="M10 21c-4-1-6-4-6-8 5 1 8 3 9 7M10 29c-5 0-8-2-10-6 5 0 9 1 12 5M13 37c-5 1-9 0-12-3 5-2 9-2 13 1M17 43c-4 2-8 2-12 0 4-3 8-4 13-2" />
                <path d="M42 21c4-1 6-4 6-8-5 1-8 3-9 7M42 29c5 0 8-2 10-6-5 0-9 1-12 5M39 37c5 1 9 0 12-3-5-2-9-2-13 1M35 43c4 2 8 2 12 0-4-3-8-4-13-2" />
              </g>
            </svg>
            <strong class="wedding-trust-signature__award-count">{weddingTrust.awardCount}</strong>
          </span>
          <span class="wedding-trust-signature__award-copy">
            <span class="wedding-trust-signature__platform">Wedding Awards</span>
            <span class="wedding-trust-signature__period">{weddingTrust.awardPeriod}</span>
          </span>
        </li>
      </>
    )}
  </ul>
</aside>

<style>
  .wedding-trust-signature { margin-top: -.6rem; color: var(--color-text); }
  .wedding-trust-signature__line { margin: 0 0 .6rem; font-family: var(--font-editorial); font-size: clamp(1.18rem, 1rem + .45vw, 1.42rem); font-style: italic; font-weight: 350; line-height: 1.2; }
  .wedding-trust-signature__groups { display: grid; grid-template-columns: repeat(3, minmax(0, max-content)); align-items: center; gap: clamp(.9rem, 2.2vw, 1.8rem); margin: 0; padding: 0; list-style: none; }
  .wedding-trust-signature__group { min-width: 0; }
  .wedding-trust-signature__rating-link { display: grid; justify-items: start; gap: .13rem; color: var(--color-text); text-decoration: none; }
  .wedding-trust-signature__platform { font-family: var(--font-interface); font-size: .78rem; font-weight: 550; line-height: 1.3; }
  .wedding-trust-signature__rating { display: flex; align-items: center; gap: .42rem; }
  .wedding-trust-signature__stars { display: inline-flex; gap: 1px; color: var(--color-muted); }
  .wedding-trust-signature__stars svg { display: block; width: .76rem; height: .76rem; fill: currentColor; }
  .wedding-trust-signature__rating strong { font-family: var(--font-interface); font-size: .78rem; font-weight: 600; line-height: 1.2; }
  .wedding-trust-signature__rating-link:hover .wedding-trust-signature__platform,
  .wedding-trust-signature__rating-link:hover .wedding-trust-signature__rating strong { text-decoration: underline; text-decoration-color: var(--color-line); text-underline-offset: .18em; }
  .wedding-trust-signature__rating-link:focus-visible { outline: 2px solid var(--color-text); outline-offset: 3px; }
  .wedding-trust-signature__awards { display: flex; align-items: center; gap: .45rem; }
  .wedding-trust-signature__laurel-wrap { position: relative; display: grid; width: 2.65rem; height: 2.75rem; flex: none; place-items: center; color: var(--color-muted); }
  .wedding-trust-signature__laurel { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .wedding-trust-signature__award-count { position: relative; color: var(--color-text); font-family: var(--font-editorial); font-size: 1.05rem; font-weight: 500; line-height: 1; }
  .wedding-trust-signature__award-copy { display: grid; gap: .1rem; }
  .wedding-trust-signature__period { color: var(--color-muted); font-family: var(--font-interface); font-size: .75rem; line-height: 1.25; }
  @media (max-width: 600px) {
    .wedding-trust-signature { margin-top: -.6rem; }
    .wedding-trust-signature__groups { grid-template-columns: repeat(2, minmax(0, max-content)); gap: .75rem 1.1rem; }
    .wedding-trust-signature__awards { grid-column: 1 / -1; }
  }
</style>

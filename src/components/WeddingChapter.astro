---
import type { ImageMetadata } from "astro";

import ImageSlot from "./ImageSlot.astro";

interface ChapterImage {
  src: ImageMetadata;
  alt: string;
  slotPath?: string;
  slotOrientation?: "horizontal" | "vertical" | "square";
}

interface Props {
  number: string;
  label: string;
  title: string;
  text: string;
  pattern: "a" | "b" | "c";
  images: readonly ChapterImage[];
}

const { number, label, title, text, pattern, images } = Astro.props;
const imageCount = images.length;
---

<section
  class:list={["wedding-chapter", `wedding-chapter--${pattern}`, `wedding-chapter--${imageCount}`]}
  aria-labelledby={`chapter-${number}`}
>
  <div class="wedding-chapter__text">
    <p class="editorial-label">{number} / {label}</p>
    <h2 id={`chapter-${number}`}>{title}</h2>
    <p>{text}</p>
  </div>

  <div
    class:list={["wedding-chapter__images", `wedding-chapter__images--${imageCount}`]}
    aria-label={`Images ${label.toLowerCase()}`}
  >
    {
      images.map((image, index) => (
        <figure class:list={["wedding-chapter__image", `wedding-chapter__image--${index + 1}`]}>
          <ImageSlot
            path={image.slotPath ?? `src/images/mariage/${label.toLowerCase()}-${index + 1}.jpg`}
            orientation={image.slotOrientation ?? "horizontal"}
          />
        </figure>
      ))
    }
  </div>
</section>

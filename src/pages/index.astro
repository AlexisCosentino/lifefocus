---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Life Focus — Design test"
  description="Page temporaire de test visuel pour la fondation éditoriale Life Focus."
>
  <section class="design-test page-shell" aria-labelledby="design-test-title">
    <div class="design-test__intro">
      <p class="editorial-label">Design test</p>
      <h1 id="design-test-title">Une fondation éditoriale pour laisser respirer les images.</h1>
      <p class="design-test__lead">
        Cette page provisoire vérifie le rythme, les espacements, la typographie et les
        éléments de structure avant la création de la page d'accueil définitive.
      </p>
    </div>

    <hr class="design-test__divider" />

    <div class="design-test__meta">
      <p class="editorial-label">Romans-sur-Isère</p>
      <p>Photographie de mariage et de famille</p>
    </div>

    <figure class="design-test__image" aria-label="Emplacement réservé à une photographie">
      <span>Image placeholder</span>
    </figure>

    <div class="design-test__body">
      <p>
        Le système visuel repose sur peu d'éléments : une serif expressive pour les grands
        moments éditoriaux, une sans-serif sobre pour la lecture, des lignes fines et de
        grands espaces pour tenir la composition.
      </p>
      <a class="editorial-link" href="/contact/">Lien éditorial</a>
    </div>
  </section>
</BaseLayout>

<style>
  .design-test {
    padding-block: var(--space-lg) var(--space-xl);
  }

  .design-test__intro {
    display: grid;
    gap: var(--space-sm);
    max-width: 72rem;
  }

  .design-test h1 {
    max-width: 11ch;
    font-family: var(--font-editorial);
    font-size: var(--text-display);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 0.9;
  }

  .design-test__lead {
    max-width: var(--reading-max);
    color: var(--color-muted);
    font-size: var(--text-lead);
    line-height: 1.45;
  }

  .design-test__divider {
    width: 100%;
    height: 1px;
    margin-block: var(--space-lg);
    border: 0;
    background: var(--color-line);
  }

  .design-test__meta {
    display: grid;
    gap: 0.4rem;
    max-width: var(--reading-max);
    margin-bottom: var(--space-md);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .design-test__image {
    display: grid;
    min-height: clamp(22rem, 58vw, 46rem);
    place-items: center;
    background: #dedbd3;
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .design-test__body {
    display: grid;
    gap: var(--space-sm);
    max-width: var(--reading-max);
    margin-top: var(--space-md);
  }

  .design-test__body p {
    font-size: var(--text-body);
  }

  @media (min-width: 56rem) {
    .design-test__body {
      margin-left: auto;
    }
  }
</style>

---
import { Image, Picture } from "astro:assets";

import BaseLayout from "../layouts/BaseLayout.astro";
import { awardImages, homeImages } from "../data/homeImages";

const pageTitle = "Photographe mariage Drôme, Valence & Romans | Life Focus";
const pageDescription =
  "Photographe de mariage dans la Drôme, à Valence et Romans-sur-Isère. Life Focus réalise des reportages de mariage naturels, vivants et spontanés.";
const mariagesNetReviewsUrl =
  "https://www.mariages.net/photo-mariage/life-focus-photographe--e180967/avis";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://lifefocus.fr/"
>
  <div class="home-page">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero__composition">
        <figure class="media hero__image">
          <Picture
            class="media__image"
            src={homeImages.hero.src}
            alt={homeImages.hero.alt}
            widths={[720, 1080, 1440, 1732]}
            sizes="(min-width: 90rem) 92vw, calc(100vw - (2 * var(--page-padding)))"
            formats={["avif", "webp"]}
            loading="eager"
            decoding="sync"
            fetchpriority="high"
          />
        </figure>

        <figure class="media hero__portrait">
          <Picture
            class="media__image"
            src={homeImages.heroSecondary.src}
            alt={homeImages.heroSecondary.alt}
            widths={[420, 640, 840, 1080]}
            sizes="(min-width: 72rem) 24vw, 58vw"
            formats={["avif", "webp"]}
            loading="eager"
          />
        </figure>

        <div class="hero__panel">
          <h1 id="home-title">
            Photographe<br />
            de mariage<br />
            dans la Drôme
          </h1>
          <p class="hero__location">Drôme · Valence · Romans-sur-Isère</p>
          <p>
            Des images vivantes et naturelles, pour raconter votre mariage sans transformer votre journée en séance photo.
          </p>
        </div>
      </div>
    </section>

    <section class="manifesto page-shell" aria-labelledby="manifesto-title">
      <div class="manifesto__composition">
        <h2 id="manifesto-title">
          Avant les images,<br />
          il y a une rencontre.
        </h2>

        <figure class="media manifesto__image">
          <Picture
            class="media__image"
            src={homeImages.breathing.src}
            alt={homeImages.breathing.alt}
            widths={[360, 540, 720, 960]}
            sizes="(min-width: 72rem) 22vw, 70vw"
            formats={["avif", "webp"]}
            loading="lazy"
          />
        </figure>
      </div>
    </section>

    <section class="marriage page-shell" aria-labelledby="marriage-title">
      <div class="marriage__intro">
        <p class="editorial-label">01 / MARIAGE</p>
        <h2 id="marriage-title">
          Être là,<br />
          sans prendre<br />
          toute la place.
        </h2>
      </div>

      <div class="marriage__images">
        <figure class="media marriage__main">
          <Picture
            class="media__image"
            src={homeImages.weddingMain.src}
            alt={homeImages.weddingMain.alt}
            widths={[640, 960, 1280, 1773]}
            sizes="(min-width: 72rem) 64vw, calc(100vw - (2 * var(--page-padding)))"
            formats={["avif", "webp"]}
            loading="lazy"
          />
        </figure>

        <figure class="media marriage__portrait">
          <Picture
            class="media__image"
            src={homeImages.weddingSecondary.src}
            alt={homeImages.weddingSecondary.alt}
            widths={[420, 640, 840, 1080]}
            sizes="(min-width: 72rem) 28vw, 72vw"
            formats={["avif", "webp"]}
            loading="lazy"
          />
        </figure>
      </div>

      <div class="marriage__copy">
        <p>
          Je vous guide quand vous en avez besoin, puis je me fais discret pour laisser
          votre mariage se vivre naturellement.
        </p>
        <a class="editorial-link" href="/mariage/">DÉCOUVRIR LE MARIAGE →</a>
      </div>
    </section>

    <section class="family" aria-labelledby="family-title">
      <div class="family__inner page-shell">
        <div class="family__words">
          <p class="editorial-label">02 / FAMILLE</p>
          <h2 id="family-title">
            Trois moments,<br />
            une même<br />
            attention.
          </h2>
        </div>

        <div class="family__visuals" aria-label="Univers photographiques famille">
          <div class="family-item family-item--grossesse">
            <a class="family-label" href="/grossesse/">Grossesse</a>
            <a class="family-media-link" href="/grossesse/" aria-label="Découvrir la séance grossesse">
              <figure class="family-media media">
                <Picture
                  class="media__image"
                  src={homeImages.familyGrossesse.src}
                  alt={homeImages.familyGrossesse.alt}
                  widths={[360, 540, 720, 960]}
                  sizes="(min-width: 72rem) 19vw, 72vw"
                  formats={["avif", "webp"]}
                  loading="lazy"
                />
              </figure>
            </a>
          </div>

          <div class="family-item family-item--naissance">
            <a class="family-label" href="/naissance/">Naissance</a>
            <a class="family-media-link" href="/naissance/" aria-label="Découvrir la séance naissance">
              <figure class="family-media media">
                <Picture
                  class="media__image"
                  src={homeImages.familyNaissance.src}
                  alt={homeImages.familyNaissance.alt}
                  widths={[360, 540, 720, 960]}
                  sizes="(min-width: 72rem) 22vw, 72vw"
                  formats={["avif", "webp"]}
                  loading="lazy"
                />
              </figure>
            </a>
          </div>

          <div class="family-item family-item--famille">
            <a class="family-label" href="/famille/">Famille</a>
            <a class="family-media-link" href="/famille/" aria-label="Découvrir la séance famille">
              <figure class="family-media media">
                <Picture
                  class="media__image"
                  src={homeImages.familyFamille.src}
                  alt={homeImages.familyFamille.alt}
                  widths={[320, 480, 640, 840]}
                  sizes="(min-width: 72rem) 22vw, 52vw"
                  formats={["avif", "webp"]}
                  loading="lazy"
                />
              </figure>
            </a>
          </div>
        </div>

        <div class="family__copy">
          <p>
            Grossesse, naissance, famille : des images naturelles pour garder une trace
            de ce que vous vivez aujourd’hui.
          </p>
          <a class="editorial-link" href="/famille/">DÉCOUVRIR LA FAMILLE →</a>
        </div>
      </div>
    </section>

    <section class="about" aria-labelledby="about-title">
      <div class="about__inner page-shell">
        <figure class="media about__image">
          <Picture
            class="media__image"
            src={homeImages.alexis.src}
            alt={homeImages.alexis.alt}
            widths={[420, 640, 840, 1100]}
            sizes="(min-width: 72rem) 32vw, calc(100vw - (2 * var(--page-padding)))"
            formats={["avif", "webp"]}
            loading="lazy"
          />
        </figure>

        <div class="about__copy">
          <p class="editorial-label">03 / À PROPOS</p>
          <h2 id="about-title">Alexis Cosentino</h2>
          <p>Je photographie les gens comme j’aimerais qu’on photographie les miens.</p>
          <a class="editorial-link" href="/a-propos/">EN SAVOIR PLUS →</a>
        </div>
      </div>
    </section>

    <section class="trust page-shell" aria-labelledby="trust-title">
      <div class="trust__heading">
        <p class="editorial-label">04 / CONFIANCE</p>
        <h2 id="trust-title">
          Depuis 2020,<br />
          chaque année.
        </h2>
      </div>

      <div class="trust__proof">
        <div class="trust__awards">
          <ol class="awards" aria-label="Wedding Awards Mariages.net">
            {
              awardImages.map((award) => (
                <li>
                  <span>{award.year}</span>
                  <a
                    href={mariagesNetReviewsUrl}
                    target="_blank"
                    rel="nofollow noopener noreferrer"
                    aria-label={`${award.alt} Voir les avis Mariages.net.`}
                  >
                    <Image src={award.src} alt={award.alt} width={112} loading="lazy" />
                  </a>
                </li>
              ))
            }
          </ol>

          <div class="trust__copy">
            <p class="trust__source">Wedding Awards — Mariages.net</p>
            <p>Une reconnaissance qui vient avant tout des couples qui m’ont fait confiance.</p>
          </div>
        </div>

        <aside class="trust__reviews" aria-label="Avis Mariages.net">
          <script
            is:inline
            src="https://cdn1.mariages.net/js/wp-widget.js?symfnw-FR48-1-20260907-006-0_www_m_"
          ></script>
          <div id="wp-widget-reviews">
            <div id="wp-widget-preview">
              Lire
              <a
                href={mariagesNetReviewsUrl}
                rel="nofollow"
              >
                nos avis
              </a>
              à&nbsp;
              <a href="https://www.mariages.net" rel="nofollow">
                <img
                  src="https://cdn1.mariages.net/assets/img/logos/gen_logoHeader.svg"
                  height="20"
                  alt="Mariages.net"
                />
              </a>
            </div>
          </div>
          <script is:inline>
            wpShowReviews(180967, "white");
          </script>
        </aside>
      </div>
    </section>

    <section class="contact page-shell" aria-labelledby="contact-title">
      <h2 id="contact-title">
        Votre histoire<br />
        commence ici.
      </h2>
      <a class="editorial-link" href="/contact/">ÉCRIVEZ-MOI →</a>
    </section>
  </div>
</BaseLayout>

<style>
  .home-page {
    --surface-dark: var(--color-dark);
    --editorial-narrow: 72rem;
  }

  .media {
    background: var(--color-line);
  }

  .media__image {
    width: 100%;
    height: auto;
  }

  .media :global(img) {
    width: 100%;
    height: auto;
  }

  .hero {
    margin-bottom: clamp(4rem, 6vw, 7rem);
    padding-top: clamp(0.5rem, 1.5vw, 1.25rem);
  }

  .hero__composition {
    position: relative;
    width: min(92vw, 1680px);
    margin-inline: auto;
    display: grid;
    align-items: end;
    isolation: isolate;
    min-width: 0;
  }

  .hero__image {
    position: relative;
    z-index: 1;
  }

  .hero__portrait {
    position: relative;
    z-index: 2;
    width: min(56vw, 21rem);
    margin-top: -2.75rem;
    margin-left: auto;
  }

  .hero__panel {
    position: relative;
    z-index: 3;
    display: grid;
    gap: 0.85rem;
    width: min(100%, 40rem);
    margin-top: clamp(-4.05rem, -10vw, -2.15rem);
    margin-left: auto;
    padding: clamp(1.35rem, 2.35vw, 2.5rem);
    background: var(--color-surface-soft);
    min-width: 0;
    overflow-wrap: break-word;
  }

  .hero h1 {
    font-family: var(--font-editorial);
    font-size: clamp(2.5rem, 1.55rem + 3.1vw, 4.75rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 0.94;
    overflow-wrap: break-word;
  }

  .hero__location {
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.35;
  }

  .hero__panel p:not(.editorial-label):not(.hero__location),
  .manifesto p,
  .marriage__copy p,
  .family__copy p,
  .trust__copy p {
    max-width: var(--reading-max);
    color: var(--color-muted);
    overflow-wrap: break-word;
  }

  .manifesto,
  .marriage,
  .trust,
  .contact {
    padding-block: var(--space-lg);
  }

  .manifesto {
    max-width: var(--editorial-narrow);
    padding-block: 0 var(--space-md);
  }

  .manifesto__composition {
    display: grid;
    gap: var(--space-sm);
    align-items: center;
    isolation: isolate;
    min-width: 0;
  }

  .manifesto h2,
  .marriage h2,
  .family h2,
  .about h2,
  .trust h2,
  .contact h2 {
    font-family: var(--font-editorial);
    font-size: clamp(2.25rem, 1.5rem + 2.8vw, 4.8rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1;
  }

  .manifesto h2 {
    z-index: 1;
    max-width: 20ch;
    font-size: clamp(2rem, 1.35rem + 2vw, 3.5rem);
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .manifesto p {
    max-width: 24rem;
    font-size: var(--text-body);
    line-height: 1.65;
  }

  .manifesto__image {
    width: min(70vw, 21rem);
    justify-self: end;
  }

  .marriage {
    max-width: var(--editorial-narrow);
    display: grid;
    gap: var(--space-sm);
    isolation: isolate;
    min-width: 0;
  }

  .marriage__intro {
    position: relative;
    z-index: 3;
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }

  .marriage h2 {
    max-width: 12ch;
    font-size: clamp(2.2rem, 1.45rem + 2.4vw, 4.4rem);
    line-height: 0.98;
    overflow-wrap: break-word;
  }

  .marriage__images {
    position: relative;
    z-index: 1;
    display: grid;
    align-items: end;
    isolation: isolate;
    min-width: 0;
  }

  .marriage__main {
    width: 100%;
  }

  .marriage__portrait {
    position: relative;
    z-index: 2;
    width: min(70vw, 24rem);
    margin-top: calc(var(--space-md) * -1);
    margin-left: auto;
  }

  .marriage__copy {
    position: relative;
    z-index: 3;
    display: grid;
    gap: var(--space-sm);
    align-content: start;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .family {
    margin-block: var(--space-lg);
    padding-block: clamp(4.5rem, 7vw, 6.5rem);
    background: var(--color-surface-soft);
  }

  .family__inner {
    display: grid;
    gap: var(--space-md) var(--space-sm);
    align-items: end;
    isolation: isolate;
    min-width: 0;
  }

  .family__words {
    position: relative;
    z-index: 4;
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }

  .family h2 {
    max-width: 13ch;
    font-size: clamp(2.1rem, 1.4rem + 2.15vw, 4.2rem);
    line-height: 1;
    overflow-wrap: break-word;
  }

  .family__visuals {
    display: grid;
    gap: var(--space-sm);
    align-items: start;
    min-width: 0;
  }

  .family-item {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.7rem;
    min-width: 0;
  }

  .family-label {
    position: relative;
    z-index: 2;
    width: fit-content;
    color: var(--color-text);
    font-family: var(--font-editorial);
    font-size: clamp(1.65rem, 1.2rem + 1.8vw, 3rem);
    line-height: 1;
    text-decoration: none;
    overflow-wrap: break-word;
  }

  .family-media {
    width: 100%;
  }

  .family-media-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .family-item--famille {
    width: min(62vw, 18rem);
    margin-left: auto;
  }

  .family__copy {
    position: relative;
    z-index: 4;
    display: grid;
    gap: var(--space-sm);
    align-content: end;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .about {
    margin-block: clamp(5rem, 8vw, 8rem);
    padding-block: 0;
    color: var(--color-background);
  }

  .about__inner {
    display: grid;
    gap: var(--space-sm);
    align-items: center;
    width: min(calc(100% - (var(--page-padding) * 1.5)), 82rem);
    margin-right: var(--page-padding);
    margin-left: auto;
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
    background: var(--surface-dark);
  }

  .about__image {
    width: 100%;
  }

  .about__copy {
    display: grid;
    gap: var(--space-sm);
  }

  .about .editorial-label,
  .about__copy p {
    color: color-mix(in srgb, var(--color-background) 76%, var(--color-white));
  }

  .about .editorial-link {
    color: var(--color-background);
  }

  .about h2 {
    font-size: clamp(2.2rem, 1.55rem + 2.4vw, 4rem);
  }

  .trust {
    display: grid;
    gap: var(--space-sm);
    padding-block: clamp(4rem, 6vw, 6rem);
  }

  .trust__heading {
    display: grid;
    gap: var(--space-xs);
  }

  .trust__source {
    color: var(--color-text);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .trust__proof {
    display: grid;
    gap: var(--space-md);
    align-items: start;
    margin-top: var(--space-sm);
  }

  .trust__awards {
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
  }

  .trust__reviews {
    min-width: 0;
    padding-top: 0.35rem;
  }

  #wp-widget-reviews {
    width: 100%;
    max-width: 34rem;
    min-height: 12rem;
    color: var(--color-text);
    font-family: var(--font-interface);
    font-size: var(--text-sm);
  }

  #wp-widget-preview {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    color: var(--color-muted);
    line-height: 1.5;
  }

  #wp-widget-preview a {
    color: var(--color-text);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  #wp-widget-preview img {
    display: inline-block;
    width: auto;
    height: 1.25rem;
    vertical-align: middle;
  }

  .awards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm) 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .awards li {
    display: grid;
    gap: 0.65rem;
    align-content: start;
    justify-items: start;
  }

  .awards span {
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.3;
  }

  .awards :global(img) {
    width: clamp(4.75rem, 18vw, 7rem);
    height: auto;
  }

  .awards a {
    display: inline-block;
    width: fit-content;
    text-decoration: none;
  }

  .contact {
    display: grid;
    gap: var(--space-sm);
    min-height: clamp(15rem, 24vw, 22rem);
    padding-block: clamp(3.5rem, 5vw, 5.5rem);
    align-content: center;
  }

  .contact h2 {
    font-size: clamp(3rem, 1.8rem + 4.8vw, 5.8rem);
  }

  @media (max-width: 42rem) {
    .hero {
      padding-top: 0.35rem;
      margin-bottom: var(--space-md);
    }

    .hero__composition {
      width: calc(100% - (var(--page-padding) * 2));
    }

    .hero__portrait {
      width: min(48vw, 14rem);
      margin-top: -2rem;
      margin-right: var(--space-xs);
    }

    .hero__panel {
      width: calc(100% - var(--space-xs));
      margin-top: clamp(-3.65rem, -10vw, -1.8rem);
      margin-left: auto;
    }

    .family__visuals {
      gap: var(--space-sm);
    }

    .family-item--grossesse {
      width: min(72vw, 18rem);
    }

    .family-item--naissance {
      width: min(100%, 30rem);
      margin-top: calc(var(--space-sm) * -0.4);
      margin-left: auto;
    }

    .family-item--famille {
      width: min(68vw, 20rem);
      margin-top: calc(var(--space-sm) * -0.3);
    }

    .marriage__portrait {
      margin-right: var(--space-xs);
    }
  }

  @media (min-width: 48rem) {
    .awards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .hero {
      padding-top: clamp(0.75rem, 1.6vw, 1.5rem);
    }

    .hero__composition {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .hero__image {
      grid-column: 1 / 10;
      grid-row: 1;
      align-self: start;
      width: 100%;
    }

    .hero__portrait {
      grid-column: 9 / 13;
      grid-row: 1;
      align-self: center;
      width: 100%;
      margin: clamp(3rem, 8vw, 6.5rem) 0 0 calc(var(--space-md) * -0.35);
    }

    .hero__panel {
      grid-column: 2 / 7;
      grid-row: 2;
      align-self: start;
      margin-top: clamp(-9.75rem, -10vw, -7rem);
      margin-bottom: 0;
      margin-right: 0;
      margin-left: 0;
    }

    .manifesto__composition {
      grid-template-columns: minmax(0, 1.2fr) minmax(14rem, 0.55fr);
    }

    .manifesto h2 {
      grid-column: 1;
      grid-row: auto;
      align-self: center;
      max-width: none;
    }

    .manifesto__image {
      grid-column: 2;
      grid-row: auto;
      align-self: center;
      width: 100%;
    }

    .marriage {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
      row-gap: 0;
    }

    .marriage__intro {
      grid-column: 1 / 5;
      grid-row: 1;
      align-self: start;
      padding-top: var(--space-xs);
    }

    .marriage__images {
      grid-column: 5 / 13;
      grid-row: 1 / 3;
      grid-template-columns: repeat(10, minmax(0, 1fr));
    }

    .marriage__main {
      grid-column: 1 / 9;
      grid-row: 1;
    }

    .marriage__portrait {
      grid-column: 8 / 11;
      grid-row: 1;
      width: 100%;
      margin: 0 0 calc(var(--space-md) * -0.45) calc(var(--space-sm) * -0.6);
    }

    .marriage__copy {
      grid-column: 1 / 5;
      grid-row: 2;
      padding-bottom: var(--space-xs);
    }

    .family__inner {

---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page introuvable | Life Focus"
  description="Cette page n’existe plus. Revenez à l’accueil ou continuez à découvrir le travail de Life Focus."
  canonicalUrl="https://www.lifefocus.fr/404/"
  robots="noindex, follow"
>
  <section class="not-found page-shell" aria-labelledby="not-found-title">
    <p class="editorial-label">404</p>

    <div class="not-found__content">
      <h1 id="not-found-title">Cette page n’existe plus.</h1>
      <p>Vous pouvez revenir à l’accueil ou continuer à découvrir mon travail.</p>

      <nav class="not-found__links" aria-label="Navigation de page introuvable">
        <a class="not-found__primary" href="/">Revenir à l’accueil</a>
        <a class="editorial-link" href="/mariage/">Découvrir le mariage →</a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: clamp(28rem, 58vh, 42rem);
    align-content: center;
    gap: var(--space-sm);
    max-width: 82rem;
    padding-block: clamp(4rem, 8vw, var(--space-xl));
  }

  .not-found__content {
    display: grid;
    gap: var(--space-sm);
    max-width: 46rem;
    min-width: 0;
    margin-left: auto;
  }

  .not-found h1 {
    font-family: var(--font-editorial);
    font-size: clamp(3rem, 1.75rem + 4.6vw, 6.5rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 0.98;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .not-found p:not(.editorial-label) {
    max-width: var(--reading-max);
    color: var(--color-muted);
  }

  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
    align-items: center;
  }

  .not-found__primary {
    display: inline-block;
    width: fit-content;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid currentColor;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-decoration: none;
    text-transform: uppercase;
  }

  .not-found__primary:hover {
    color: var(--color-muted);
  }

  @media (max-width: 42rem) {
    .not-found__content {
      margin-left: 0;
    }
  }
</style>

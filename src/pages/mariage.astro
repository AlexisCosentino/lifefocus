---
import { Picture } from "astro:assets";

import WeddingChapter from "../components/WeddingChapter.astro";
import WeddingFAQ from "../components/WeddingFAQ.astro";
import WeddingGallery from "../components/WeddingGallery.astro";
import WeddingPackages from "../components/WeddingPackages.astro";
import { homeImages } from "../data/homeImages";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Photographe mariage Drôme, Valence et Romans-sur-Isère - Life Focus";
const pageDescription =
  "Reportage photo de mariage dans la Drôme, autour de Valence et Romans-sur-Isère, par Alexis Cosentino pour Life Focus.";

const chapterImageSet = [
  homeImages.hero,
  homeImages.weddingSecondary,
  homeImages.weddingMain,
  homeImages.heroSecondary,
] as const;

const chapters = [
  {
    number: "03",
    label: "PRÉPARATIFS",
    title: "Le calme avant l'arrivée des autres.",
    text: "Les détails, les gestes simples, les proches qui passent. Une partie discrète du reportage, souvent très personnelle.",
    pattern: "a",
    images: chapterImageSet,
  },
  {
    number: "04",
    label: "CÉRÉMONIE",
    title: "Rester attentif à ce qui se joue vraiment.",
    text: "Les regards, les mains, les silences et les réactions. Je photographie ce qui existe déjà, sans interrompre le moment.",
    pattern: "b",
    images: [homeImages.weddingMain, homeImages.heroSecondary, homeImages.hero, homeImages.weddingSecondary],
  },
  {
    number: "05",
    label: "COUPLE",
    title: "Quelques minutes pour souffler ensemble.",
    text: "Je vous guide juste assez pour que les images restent naturelles, avec une vraie place pour votre manière d'être.",
    pattern: "c",
    images: [homeImages.hero, homeImages.weddingSecondary, homeImages.weddingMain, homeImages.heroSecondary],
  },
  {
    number: "06",
    label: "INVITES",
    title: "Les personnes qui donnent du relief à l'histoire.",
    text: "Un rire, une accolade, un regard depuis une table. Les invités racontent souvent le mariage autant que les moments attendus.",
    pattern: "a",
    images: [homeImages.weddingMain, homeImages.hero, homeImages.heroSecondary, homeImages.weddingSecondary],
  },
  {
    number: "07",
    label: "SOIREE",
    title: "Quand la journée devient plus libre.",
    text: "La lumière baisse, les corps se rapprochent, les gestes changent. La soirée apporte une énergie différente au reportage.",
    pattern: "b",
    images: [homeImages.hero, homeImages.weddingSecondary, homeImages.weddingMain, homeImages.heroSecondary],
  },
] as const;

const galleryImages = [
  { ...homeImages.hero, size: "wide" },
  { ...homeImages.weddingSecondary, size: "vertical" },
  { ...homeImages.weddingMain, size: "small" },
  { ...homeImages.heroSecondary, size: "vertical" },
  { ...homeImages.hero, size: "small" },
  { ...homeImages.weddingMain, size: "wide" },
  { ...homeImages.weddingSecondary, size: "vertical" },
  { ...homeImages.hero, size: "small" },
  { ...homeImages.heroSecondary, size: "vertical" },
  { ...homeImages.weddingMain, size: "small" },
  { ...homeImages.hero, size: "wide" },
  { ...homeImages.weddingSecondary, size: "vertical" },
  { ...homeImages.weddingMain, size: "small" },
  { ...homeImages.heroSecondary, size: "vertical" },
  { ...homeImages.hero, size: "small" },
  { ...homeImages.weddingMain, size: "wide" },
  { ...homeImages.weddingSecondary, size: "vertical" },
  { ...homeImages.hero, size: "small" },
] as const;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://lifefocus.fr/mariage/"
>
  <div class="wedding-page">
    <section class="wedding-hero" aria-labelledby="wedding-title">
      <div class="wedding-hero__inner">
        <div class="wedding-hero__images" aria-label="Reportage photo de mariage">
          <figure class="wedding-hero__main">
            <Picture
              src={homeImages.hero.src}
              alt={homeImages.hero.alt}
              widths={[720, 1080, 1440, 1732]}
              sizes="(min-width: 72rem) 58vw, calc(100vw - (2 * var(--page-padding)))"
              formats={["avif", "webp"]}
              loading="eager"
              decoding="sync"
              fetchpriority="high"
            />
          </figure>

          <figure class="wedding-hero__secondary">
            <Picture
              src={homeImages.weddingSecondary.src}
              alt={homeImages.weddingSecondary.alt}
              widths={[360, 540, 720, 960]}
              sizes="(min-width: 72rem) 20vw, 46vw"
              formats={["avif", "webp"]}
              loading="eager"
            />
          </figure>
        </div>

        <div class="wedding-hero__text">
          <p class="editorial-label">MARIAGE</p>
          <h1 id="wedding-title">Photographier votre journée sans la transformer en séance photo.</h1>
          <p>
            Des moments vécus, des personnes qui comptent, et des images qui racontent vraiment ce qui s'est passé.
          </p>
        </div>
      </div>
    </section>

    <section class="wedding-approach page-shell" aria-labelledby="approach-title">
      <div class="wedding-approach__text">
        <p class="editorial-label">01 / MON APPROCHE</p>
        <h2 id="approach-title">Une présence proche, mais jamais envahissante.</h2>
        <p>
          Un mariage avance vite. Je cherche les images qui restent humaines: les gestes avant les grands moments,
          les visages autour de vous, les choses imparfaites qui racontent la vraie journée.
        </p>
      </div>

      <figure class="wedding-approach__image">
        <Picture
          src={homeImages.weddingMain.src}
          alt={homeImages.weddingMain.alt}
          widths={[540, 720, 960, 1280, 1773]}
          sizes="(min-width: 72rem) 39vw, calc(100vw - (2 * var(--page-padding)))"
          formats={["avif", "webp"]}
          loading="lazy"
        />
      </figure>
    </section>

    {
      chapters.map((chapter) => (
        <WeddingChapter
          number={chapter.number}
          label={chapter.label}
          title={chapter.title}
          text={chapter.text}
          pattern={chapter.pattern}
          images={chapter.images}
        />
      ))
    }

    <section class="wedding-support" aria-labelledby="support-title">
      <div class="wedding-support__inner page-shell">
        <div class="wedding-support__intro">
          <p class="editorial-label">08 / MON ACCOMPAGNEMENT</p>
          <h2 id="support-title">Garder le fil sans prendre toute la place.</h2>
        </div>

        <div class="wedding-support__steps">
          <section>
            <h3>AVANT</h3>
            <p>Un échange pour comprendre votre journée, les personnes importantes et les moments à ne pas manquer.</p>
          </section>
          <section>
            <h3>LE JOUR J</h3>
            <p>Une présence calme, attentive, avec des indications seulement lorsque cela aide vraiment.</p>
          </section>
          <section>
            <h3>APRES</h3>
            <p>Un tri soigneux, une cohérence de rendu et une galerie pensée pour retrouver simplement vos images.</p>
          </section>
        </div>
      </div>
    </section>

    <WeddingPackages />
    <WeddingGallery images={galleryImages} />
    <WeddingFAQ />

    <section class="wedding-contact page-shell" aria-labelledby="wedding-contact-title">
      <h2 id="wedding-contact-title">Votre histoire commence ici.</h2>
      <a class="editorial-link" href="/contact/">ÉCRIVEZ-MOI →</a>
    </section>
  </div>
</BaseLayout>

<style>
  .wedding-page {
    --service-narrow: 76rem;
  }

  .wedding-page :global(figure) {
    margin: 0;
    background: var(--color-line);
  }

  .wedding-page :global(img) {
    width: 100%;
    height: auto;
  }

  .wedding-hero {
    padding-block: clamp(0.75rem, 1.8vw, 1.5rem) clamp(4.5rem, 7vw, 6.5rem);
  }

  .wedding-hero__inner {
    display: grid;
    align-items: start;
    width: min(92vw, 82rem);
    margin-inline: auto;
    isolation: isolate;
    min-width: 0;
  }

  .wedding-hero__text {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0.85rem;
    width: min(100%, 38rem);
    margin-top: clamp(-3.5rem, -8vw, -1.8rem);
    margin-left: auto;
    padding: clamp(1.35rem, 2.35vw, 2.35rem);
    background: var(--color-surface-soft);
    min-width: 0;
    overflow-wrap: break-word;
  }

  .wedding-hero h1,
  .wedding-approach h2,
  .wedding-page :global(.wedding-chapter h2),
  .wedding-support h2,
  .wedding-page :global(.wedding-packages h2),
  .wedding-page :global(.wedding-gallery h2),
  .wedding-page :global(.wedding-faq h2),
  .wedding-contact h2 {
    font-family: var(--font-editorial);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .wedding-hero h1 {
    max-width: 12ch;
    font-size: clamp(2.55rem, 1.55rem + 3.15vw, 4.85rem);
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .wedding-hero p:not(.editorial-label),
  .wedding-approach p:not(.editorial-label),
  .wedding-page :global(.wedding-chapter__text p:not(.editorial-label)),
  .wedding-support p,
  .wedding-page :global(.wedding-packages p),
  .wedding-page :global(.wedding-faq p) {
    max-width: var(--reading-max);
    color: var(--color-muted);
  }

  .wedding-hero__images {
    position: relative;
    display: grid;
    align-items: end;
    isolation: isolate;
    z-index: 1;
    min-width: 0;
  }

  .wedding-hero__main {
    position: relative;
    z-index: 1;
  }

  .wedding-hero__secondary {
    position: relative;
    z-index: 2;
    width: min(48vw, 15rem);
    margin-top: calc(var(--space-sm) * -1);
    margin-left: auto;
  }

  .wedding-approach {
    display: grid;
    gap: var(--space-md);
    align-items: end;
    max-width: var(--service-narrow);
    padding-block: var(--space-lg);
  }

  .wedding-approach__text {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }

  .wedding-approach h2 {
    max-width: 13ch;
    font-size: clamp(2.45rem, 1.55rem + 3vw, 5rem);
  }

  .wedding-approach__image {
    width: 100%;
  }

  .wedding-page :global(.wedding-chapter) {
    display: grid;
    gap: var(--space-md);
    max-width: var(--service-narrow);
    margin-inline: auto;
    padding: var(--space-lg) var(--page-padding);
  }

  .wedding-page :global(.wedding-chapter__text) {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }

  .wedding-page :global(.wedding-chapter h2) {
    max-width: 13ch;
    font-size: clamp(2.35rem, 1.5rem + 2.8vw, 4.8rem);
  }

  .wedding-page :global(.wedding-chapter__images) {
    position: relative;
    display: grid;
    gap: 1.1rem;
    align-items: start;
    isolation: isolate;
    min-width: 0;
  }

  .wedding-page :global(.wedding-chapter__image) {
    width: 100%;
  }

  .wedding-page :global(.wedding-chapter__image--2),
  .wedding-page :global(.wedding-chapter__image--4) {
    width: min(72vw, 22rem);
  }

  .wedding-page :global(.wedding-chapter__image--2) {
    margin-top: calc(var(--space-sm) * -0.65);
    margin-left: auto;
  }

  .wedding-page :global(.wedding-chapter__image--3) {
    width: min(64vw, 18rem);
  }

  .wedding-page :global(.wedding-chapter__image--4) {
    margin-left: auto;
  }

  .wedding-support {
    margin-block: var(--space-lg);
    color: var(--color-background);
  }

  .wedding-support__inner {
    display: grid;
    gap: var(--space-md);
    width: min(calc(100% - (var(--page-padding) * 1.4)), 84rem);
    margin-right: var(--page-padding);
    margin-left: auto;
    padding-block: clamp(4rem, 7vw, 6.5rem);
    background: var(--color-dark);
  }

  .wedding-support__intro {
    display: grid;
    gap: var(--space-xs);
  }

  .wedding-support h2 {
    max-width: 13ch;
    font-size: clamp(2.45rem, 1.55rem + 3vw, 5rem);
  }

  .wedding-support .editorial-label,
  .wedding-support p {
    color: color-mix(in srgb, var(--color-background) 76%, var(--color-white));
  }

  .wedding-support__steps {
    display: grid;
    gap: var(--space-sm);
  }

  .wedding-support__steps section {
    display: grid;
    gap: 0.8rem;
    padding-top: var(--space-xs);
    border-top: 1px solid color-mix(in srgb, var(--color-background) 22%, transparent);
  }

  .wedding-support h3,
  .wedding-page :global(.wedding-packages h3),
  .wedding-page :global(.wedding-packages__eyebrow) {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .wedding-page :global(.wedding-packages),
  .wedding-page :global(.wedding-faq),
  .wedding-contact {
    max-width: var(--service-narrow);
    padding-block: var(--space-lg);
  }

  .wedding-page :global(.wedding-gallery) {
    width: 100%;
    padding-block: var(--space-lg);
  }

  .wedding-page :global(.wedding-packages__intro),
  .wedding-page :global(.wedding-gallery__intro),
  .wedding-page :global(.wedding-faq__intro) {
    display: grid;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .wedding-page :global(.wedding-packages h2),
  .wedding-page :global(.wedding-gallery h2),
  .wedding-page :global(.wedding-faq h2),
  .wedding-contact h2 {
    max-width: 13ch;
    font-size: clamp(2.45rem, 1.55rem + 3vw, 5rem);
  }

  .wedding-page :global(.wedding-packages__body) {
    display: grid;
    gap: var(--space-md);
  }

  .wedding-page :global(.wedding-packages__base) {
    display: grid;
    gap: 0.75rem;
    max-width: var(--reading-max);
  }

  .wedding-page :global(.wedding-packages__eyebrow) {
    color: var(--color-text);
  }

  .wedding-page :global(.wedding-packages__list) {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .wedding-page :global(.wedding-packages__list li) {
    display: grid;
    gap: 0.75rem;
    padding-block: 1.3rem;
    border-bottom: 1px solid var(--color-line);
  }

  .wedding-page :global(.wedding-gallery__grid) {
    display: grid;
    gap: var(--space-sm);
    align-items: start;
    width: min(94vw, 104rem);
    margin-inline: auto;
    padding-inline: var(--page-padding);
  }

  .wedding-page :global(.wedding-gallery__item) {
    width: 100%;
  }

  .wedding-page :global(.wedding-gallery__item--vertical) {
    width: min(76vw, 24rem);
  }

  .wedding-page :global(.wedding-gallery__item--small) {
    width: min(70vw, 22rem);
  }

  .wedding-page :global(.wedding-gallery__item:nth-child(even)) {
    margin-left: auto;
  }

  .wedding-page :global(.wedding-faq__items) {
    display: grid;
    border-top: 1px solid var(--color-line);
  }

  .wedding-page :global(.wedding-faq details) {
    border-bottom: 1px solid var(--color-line);
  }

  .wedding-page :global(.wedding-faq summary) {
    cursor: pointer;
    padding-block: 1.25rem;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .wedding-page :global(.wedding-faq details p) {
    padding-bottom: 1.25rem;
  }

  .wedding-contact {
    display: grid;
    gap: var(--space-sm);
    align-content: center;
    min-height: clamp(14rem, 22vw, 20rem);
  }

  @media (min-width: 48rem) {
    .wedding-support__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .wedding-page :global(.wedding-packages__list li) {
      grid-template-columns: minmax(8rem, 0.35fr) minmax(0, 1fr);
      gap: var(--space-sm);
    }
  }

  @media (min-width: 72rem) {
    .wedding-hero {
      padding-bottom: clamp(5.5rem, 8vw, 7.5rem);
    }

    .wedding-hero__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .wedding-hero__images {
      grid-column: 4 / 13;
      grid-row: 1;
      grid-template-columns: repeat(10, minmax(0, 1fr));
      align-items: start;
      justify-self: end;
      width: min(64vw, 54rem);
    }

    .wedding-hero__main {
      grid-column: 1 / 9;
      grid-row: 1;
    }

    .wedding-hero__secondary {
      grid-column: 8 / 11;
      grid-row: 1;
      align-self: start;
      width: 100%;
      margin: clamp(3rem, 5.5vw, 4.75rem) 0 0 calc(var(--space-sm) * -0.55);
    }

    .wedding-hero__text {
      grid-column: 1 / 6;
      grid-row: 1;
      align-self: start;
      margin-top: clamp(2rem, 4.5vw, 3.75rem);
      margin-right: 0;
      margin-left: 0;
    }

    .wedding-approach {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
      gap: clamp(3rem, 7vw, 7rem);
    }

    .wedding-approach__image {
      align-self: end;
    }

    .wedding-page :global(.wedding-chapter) {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
      gap: clamp(3rem, 6vw, 6rem);
    }

    .wedding-page :global(.wedding-chapter__text) {
      grid-column: 1 / 5;
      align-self: start;
      padding-top: clamp(1rem, 3vw, 3rem);
    }

    .wedding-page :global(.wedding-chapter__images) {
      grid-column: 5 / 13;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 0;
    }

    .wedding-page :global(.wedding-chapter__image--1) {
      grid-column: 1 / 9;
      grid-row: 1 / 3;
      z-index: 1;
    }

    .wedding-page :global(.wedding-chapter__image--2) {
      grid-column: 8 / 13;
      grid-row: 1;
      z-index: 2;
      width: 100%;
      margin: clamp(2rem, 5vw, 4rem) 0 0 calc(var(--space-sm) * -0.6);
    }

    .wedding-page :global(.wedding-chapter__image--3) {
      grid-column: 2 / 6;
      grid-row: 2;
      z-index: 3;
      width: 100%;
      margin-top: calc(var(--space-md) * -0.55);
    }

    .wedding-page :global(.wedding-chapter__image--4) {
      grid-column: 7 / 11;
      grid-row: 2;
      z-index: 4;
      width: 100%;
      margin: calc(var(--space-lg) * -0.1) 0 0;
    }

    .wedding-page :global(.wedding-chapter--b .wedding-chapter__text) {
      grid-column: 8 / 13;
    }

    .wedding-page :global(.wedding-chapter--b .wedding-chapter__images) {
      grid-column: 1 / 8;
      grid-row: 1;
    }

    .wedding-page :global(.wedding-chapter--c .wedding-chapter__text) {
      grid-column: 1 / 6;
    }

    .wedding-page :global(.wedding-chapter--c .wedding-chapter__images) {
      grid-column: 6 / 13;
    }

    .wedding-page :global(.wedding-packages__body) {
      grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
      align-items: start;
    }

    .wedding-page :global(.wedding-gallery__grid) {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: clamp(1.25rem, 2vw, 2rem);
    }

    .wedding-page :global(.wedding-gallery__item--wide) {
      grid-column: span 7;
    }

    .wedding-page :global(.wedding-gallery__item--vertical) {
      grid-column: span 4;
      width: 100%;
    }

    .wedding-page :global(.wedding-gallery__item--small) {
      grid-column: span 3;
      width: 100%;
    }

    .wedding-page :global(.wedding-gallery__item:nth-child(6n + 2)) {
      margin-top: var(--space-md);
    }

    .wedding-page :global(.wedding-gallery__item:nth-child(6n + 5)) {
      margin-top: calc(var(--space-md) * -0.35);
    }

    .wedding-page :global(.wedding-faq) {
      display: grid;
      grid-template-columns: minmax(0, 0.48fr) minmax(0, 1fr);
      gap: clamp(3rem, 7vw, 7rem);
      align-items: start;
    }

    .wedding-page :global(.wedding-faq__intro) {
      margin-bottom: 0;
    }

    .wedding-contact {
      grid-template-columns: minmax(0, 0.55fr) minmax(0, 1fr);
    }

    .wedding-contact h2,
    .wedding-contact a {
      grid-column: 2;
    }
  }
</style>

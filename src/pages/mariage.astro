---
import ImageSlot from "../components/ImageSlot.astro";
import WeddingChapter from "../components/WeddingChapter.astro";
import WeddingFAQ from "../components/WeddingFAQ.astro";
import WeddingGallery from "../components/WeddingGallery.astro";
import WeddingPackages from "../components/WeddingPackages.astro";
import { homeImages } from "../data/homeImages";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Photographe mariage Drôme, Valence & Provence | Life Focus";
const pageDescription =
  "Photographe de mariage à Valence, Romans-sur-Isère, dans la Drôme et en Provence. Reportage naturel et spontané pour raconter votre journée sans la figer.";

const weddingImage = (
  image: typeof homeImages[keyof typeof homeImages],
  slotPath: string,
  slotOrientation: "horizontal" | "vertical" = "horizontal",
) => ({
  ...image,
  slotPath,
  slotOrientation,
});

const chapterImageSet = [
  weddingImage(homeImages.hero, "src/images/mariage/preparation-1.jpg"),
  weddingImage(homeImages.weddingSecondary, "src/images/mariage/preparation-2.jpg", "vertical"),
  weddingImage(homeImages.weddingMain, "src/images/mariage/preparation-3.jpg"),
  weddingImage(homeImages.heroSecondary, "src/images/mariage/preparation-4.jpg", "vertical"),
] as const;

const chapters = [
  {
    number: "02",
    label: "PRÉPARATIFS",
    title: "Le calme avant l’arrivée des autres.",
    text: "Les préparatifs racontent déjà beaucoup de votre mariage : les proches qui arrivent, les derniers détails, l’émotion qui monte. Je photographie ces instants sans les interrompre, au plus près de ce qui se passe.",
    pattern: "a",
    images: chapterImageSet,
  },
  {
    number: "03",
    label: "CÉRÉMONIE",
    title: "Rester attentif à ce qui se joue vraiment.",
    text: "Les regards, les mains qui se cherchent, les réactions de vos proches, les silences. Pendant la cérémonie, je reste attentif à tout ce qui raconte votre histoire sans jamais prendre la place du moment.",
    pattern: "b",
    images: [
      weddingImage(homeImages.weddingMain, "src/images/mariage/ceremony-1.jpg"),
      weddingImage(homeImages.heroSecondary, "src/images/mariage/ceremony-2.jpg", "vertical"),
      weddingImage(homeImages.hero, "src/images/mariage/ceremony-3.jpg"),
      weddingImage(homeImages.weddingSecondary, "src/images/mariage/ceremony-4.jpg", "vertical"),
    ],
  },
  {
    number: "04",
    label: "COUPLE",
    title: "Quelques minutes pour souffler ensemble.",
    text: "Pas besoin de disparaître une heure de votre mariage pour avoir de belles photos de couple. Quelques minutes suffisent souvent. Je vous guide juste assez pour créer des images naturelles tout en vous laissant profiter l’un de l’autre.",
    pattern: "c",
    images: [weddingImage(homeImages.hero, "src/images/mariage/couple-1.jpg")],
  },
  {
    number: "05",
    label: "INVITÉS",
    title: "Les personnes qui donnent du relief à l'histoire.",
    text: "Un rire au cocktail, une discussion à l’écart, un regard pendant la cérémonie. Vos invités font partie intégrante du reportage et donnent à vos photos tout ce qui rend cette journée vraiment personnelle.",
    pattern: "a",
    images: [
      weddingImage(homeImages.weddingMain, "src/images/mariage/guests-1.jpg"),
      weddingImage(homeImages.hero, "src/images/mariage/guests-2.jpg"),
      weddingImage(homeImages.heroSecondary, "src/images/mariage/guests-3.jpg", "vertical"),
      weddingImage(homeImages.weddingSecondary, "src/images/mariage/guests-4.jpg", "vertical"),
    ],
  },
  {
    number: "06",
    label: "SOIRÉE",
    title: "Quand la journée devient plus libre.",
    text: "La lumière baisse, les discours laissent place à la fête et les gestes deviennent plus spontanés. Je continue à raconter votre mariage avec la même attention, jusque dans son énergie la plus libre.",
    pattern: "b",
    images: [
      weddingImage(homeImages.hero, "src/images/mariage/party-1.jpg"),
      weddingImage(homeImages.weddingMain, "src/images/mariage/party-2.jpg"),
    ],
  },
] as const;

const galleryImageFallbacks = [
  { ...homeImages.hero, size: "wide" },
  { ...homeImages.weddingSecondary, size: "vertical" },
  { ...homeImages.weddingMain, size: "small" },
  { ...homeImages.heroSecondary, size: "vertical" },
  { ...homeImages.hero, size: "small" },
  { ...homeImages.weddingMain, size: "wide" },
  { ...homeImages.weddingSecondary, size: "vertical" },
  { ...homeImages.hero, size: "small" },
  { ...homeImages.heroSecondary, size: "vertical" },
  { ...homeImages.weddingMain, size: "small" },
  { ...homeImages.hero, size: "wide" },
  { ...homeImages.weddingSecondary, size: "vertical" },
  { ...homeImages.weddingMain, size: "small" },
  { ...homeImages.heroSecondary, size: "vertical" },
  { ...homeImages.hero, size: "small" },
  { ...homeImages.weddingMain, size: "wide" },
  { ...homeImages.weddingSecondary, size: "vertical" },
  { ...homeImages.hero, size: "small" },
] as const;

const galleryImages = galleryImageFallbacks.map((image, index) => ({
  ...image,
  slotPath: `src/images/mariage/gallery/${String(index + 1).padStart(2, "0")}.jpg`,
  slotOrientation: image.size === "vertical" ? "vertical" : "horizontal",
}));
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://www.lifefocus.fr/mariage/"
>
  <div class="wedding-page">
    <section class="wedding-hero" aria-labelledby="wedding-title">
      <div class="wedding-hero__inner">
        <div class="wedding-hero__images" aria-label="Reportage photo de mariage">
          <figure class="wedding-hero__main">
            <ImageSlot
              path="src/images/mariage/hero-main.jpg"
              orientation="horizontal"
              loading="eager"
              quality={92}
              sizes="(min-width: 72rem) 58vw, calc(100vw - (2 * var(--page-padding)))"
            />
          </figure>

          <figure class="wedding-hero__secondary">
            <ImageSlot
              path="src/images/mariage/hero-secondary.jpg"
              orientation="vertical"
              loading="eager"
              quality={92}
              sizes="(min-width: 72rem) 20vw, 46vw"
            />
          </figure>
        </div>

        <div class="wedding-hero__text">
          <p class="editorial-label">MARIAGE · DRÔME · PROVENCE</p>
          <h1 id="wedding-title">Photographe de mariage dans la Drôme et en Provence.</h1>
          <p>
            Basé à Romans-sur-Isère, près de Valence, je photographie les mariages avec une approche naturelle et spontanée, sans transformer votre journée en séance photo.
          </p>
        </div>
      </div>
    </section>

    <section class="wedding-approach page-shell" aria-labelledby="approach-title">
      <div class="wedding-approach__text">
        <p class="editorial-label">01 / MON APPROCHE</p>
        <h2 id="approach-title">Une présence proche, mais jamais envahissante.</h2>
        <p>
          Je photographie votre mariage comme un reportage : les grands moments, les regards,
          les gestes et tout ce qui se passe entre les deux. Je vous guide lorsque c’est utile,
          puis je me fais discret pour laisser votre journée se vivre naturellement.
        </p>
      </div>

      <figure class="wedding-approach__image">
        <ImageSlot path="src/images/mariage/approach-main.jpg" orientation="horizontal" />
      </figure>
    </section>

    {
      chapters.map((chapter) => (
        <WeddingChapter
          number={chapter.number}
          label={chapter.label}
          title={chapter.title}
          text={chapter.text}
          pattern={chapter.pattern}
          images={chapter.images}
        />
      ))
    }

    <section class="wedding-support" aria-labelledby="support-title">
      <div class="wedding-support__inner page-shell">
        <div class="wedding-support__intro">
          <p class="editorial-label">07 / MON ACCOMPAGNEMENT</p>
          <h2 id="support-title">Garder le fil sans prendre toute la place.</h2>
        </div>

        <div class="wedding-support__steps">
          <section>
            <h3>AVANT</h3>
            <p>Un échange pour comprendre votre journée, votre organisation et les personnes qui comptent pour vous.</p>
          </section>
          <section>
            <h3>LE JOUR J</h3>
            <p>Une présence calme et attentive, avec quelques indications lorsque c’est utile et beaucoup de place laissée au naturel.</p>
          </section>
          <section>
            <h3>APRÈS</h3>
            <p>Une sélection soignée, un travail cohérent sur chaque image et une galerie privée pour revivre votre mariage.</p>
          </section>
        </div>
      </div>
    </section>

    <WeddingPackages />
    <WeddingGallery images={galleryImages} galleryFolder="src/images/mariage/gallery" />
    <WeddingFAQ />

    <section class="wedding-contact page-shell" aria-labelledby="wedding-contact-title">
      <h2 id="wedding-contact-title">Votre histoire commence ici.</h2>
      <a class="editorial-link" href="/contact/">ÉCRIVEZ-MOI →</a>
    </section>
  </div>
</BaseLayout>

<style>
  .wedding-page {
    --service-narrow: 76rem;
  }

  .wedding-page :global(figure) {
    margin: 0;
    background: var(--color-line);
  }

  .wedding-page :global(img) {
    width: 100%;
    height: auto;
  }

  .wedding-hero {
    padding-block: clamp(0.75rem, 1.8vw, 1.5rem) clamp(4.5rem, 7vw, 6.5rem);
  }

  .wedding-hero__inner {
    display: grid;
    align-items: start;
    width: min(92vw, 82rem);
    margin-inline: auto;
    isolation: isolate;
    min-width: 0;
  }

  .wedding-hero__text {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0.85rem;
    width: min(100%, 38rem);
    margin-top: clamp(-3.5rem, -8vw, -1.8rem);
    margin-left: auto;
    padding: clamp(1.35rem, 2.35vw, 2.35rem);
    background: var(--color-surface-soft);
    min-width: 0;
    overflow-wrap: break-word;
  }

  .wedding-hero h1,
  .wedding-approach h2,
  .wedding-page :global(.wedding-chapter h2),
  .wedding-support h2,
  .wedding-page :global(.wedding-packages h2),
  .wedding-page :global(.wedding-faq h2),
  .wedding-contact h2 {
    font-family: var(--font-editorial);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .wedding-hero h1 {
    max-width: 12ch;
    font-size: clamp(2.55rem, 1.55rem + 3.15vw, 4.85rem);
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .wedding-hero p:not(.editorial-label),
  .wedding-approach p:not(.editorial-label),
  .wedding-page :global(.wedding-chapter__text p:not(.editorial-label)),
  .wedding-support p,
  .wedding-page :global(.wedding-packages p),
  .wedding-page :global(.wedding-faq p) {
    max-width: var(--reading-max);
    color: var(--color-muted);
  }

  .wedding-hero__images {
    position: relative;
    display: grid;
    align-items: end;
    isolation: isolate;
    z-index: 1;
    min-width: 0;
  }

  .wedding-hero__main {
    position: relative;
    z-index: 1;
  }

  .wedding-hero__secondary {
    position: relative;
    z-index: 2;
    width: min(48vw, 15rem);
    margin-top: calc(var(--space-sm) * -1);
    margin-left: auto;
  }

  .wedding-approach {
    display: grid;
    gap: var(--space-md);
    align-items: end;
    max-width: var(--service-narrow);
    padding-block: clamp(3.75rem, 6vw, 5.5rem);
  }

  .wedding-approach__text {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }

  .wedding-approach h2 {
    max-width: 13ch;
    font-size: clamp(2.45rem, 1.55rem + 3vw, 5rem);
  }

  .wedding-approach__image {
    width: 100%;
  }

  .wedding-page :global(.wedding-chapter) {
    display: grid;
    gap: var(--space-md);
    max-width: var(--service-narrow);
    margin-inline: auto;
    padding: clamp(3.75rem, 6vw, 5.5rem) var(--page-padding);
  }

  .wedding-page :global(.wedding-chapter__text) {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }

  .wedding-page :global(.wedding-chapter h2) {
    max-width: 13ch;
    font-size: clamp(2.35rem, 1.5rem + 2.8vw, 4.8rem);
  }

  .wedding-page :global(.wedding-chapter__images) {
    position: relative;
    display: grid;
    gap: 1.1rem;
    align-items: start;
    isolation: isolate;
    min-width: 0;
  }

  .wedding-page :global(.wedding-chapter__image) {
    width: 100%;
  }

  .wedding-page :global(.wedding-chapter__image--2),
  .wedding-page :global(.wedding-chapter__image--4) {
    width: min(72vw, 22rem);
  }

  .wedding-page :global(.wedding-chapter__image--2) {
    margin-top: calc(var(--space-sm) * -0.65);
    margin-left: auto;
  }

  .wedding-page :global(.wedding-chapter__image--3) {
    width: min(64vw, 18rem);
  }

  .wedding-page :global(.wedding-chapter__image--4) {
    margin-left: auto;
  }

  .wedding-page :global(.wedding-chapter__images--2 .wedding-chapter__image--2) {
    margin-top: calc(var(--space-sm) * -0.35);
  }

  .wedding-support {
    margin-block: var(--space-lg);
    color: var(--color-background);
  }

  .wedding-support__inner {
    display: grid;
    gap: var(--space-md);
    width: min(calc(100% - (var(--page-padding) * 1.4)), 84rem);
    margin-right: var(--page-padding);
    margin-left: auto;
    padding-block: clamp(4rem, 7vw, 6.5rem);
    background: var(--color-dark);
  }

  .wedding-support__intro {
    display: grid;
    gap: var(--space-xs);
  }

  .wedding-support h2 {
    max-width: 13ch;
    font-size: clamp(2.45rem, 1.55rem + 3vw, 5rem);
  }

  .wedding-support .editorial-label,
  .wedding-support p {
    color: color-mix(in srgb, var(--color-background) 76%, var(--color-white));
  }

  .wedding-support__steps {
    display: grid;
    gap: var(--space-sm);
  }

  .wedding-support__steps section {
    display: grid;
    gap: 0.8rem;
    padding-top: var(--space-xs);
    border-top: 1px solid color-mix(in srgb, var(--color-background) 22%, transparent);
  }

  .wedding-support h3,
  .wedding-page :global(.wedding-packages__eyebrow) {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .wedding-page :global(.wedding-packages),
  .wedding-page :global(.wedding-faq),
  .wedding-contact {
    max-width: var(--service-narrow);
    padding-block: var(--space-lg);
  }

  .wedding-page :global(.wedding-packages__intro),
  .wedding-page :global(.wedding-faq__intro) {
    display: grid;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .wedding-page :global(.wedding-packages__intro) {
    gap: var(--space-md);
  }

  .wedding-page :global(.wedding-packages__heading) {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }

  .wedding-page :global(.wedding-packages h2),
  .wedding-page :global(.wedding-faq h2),
  .wedding-contact h2 {
    max-width: 13ch;
    font-size: clamp(2.45rem, 1.55rem + 3vw, 5rem);
  }

  .wedding-page :global(.wedding-packages__included-section),
  .wedding-page :global(.wedding-packages__formulas) {
    display: grid;
    gap: var(--space-md);
  }

  .wedding-page :global(.wedding-packages__included-section) {
    margin-bottom: clamp(var(--space-md), 6vw, var(--space-lg));
  }

  .wedding-page :global(.wedding-packages__formulas) {
    gap: var(--space-sm);
  }

  .wedding-page :global(.wedding-packages__base) {
    display: grid;
    gap: 1rem;
    max-width: var(--reading-max);
  }

  .wedding-page :global(.wedding-packages__eyebrow) {
    color: var(--color-text);
  }

  .wedding-page :global(.wedding-packages__included) {
    counter-reset: included;
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .wedding-page :global(.wedding-packages__included li) {
    counter-increment: included;
    display: grid;
    grid-template-columns: clamp(2.8rem, 7vw, 4.4rem) minmax(0, 1fr);
    gap: clamp(1rem, 2.5vw, 1.8rem);
    align-items: start;
    max-width: none;
    padding-block: clamp(1.15rem, 2.2vw, 1.65rem);
    border-bottom: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: clamp(0.98rem, 0.94rem + 0.16vw, 1.08rem);
    line-height: 1.65;
  }

  .wedding-page :global(.wedding-packages__included li::before) {
    content: counter(included, decimal-leading-zero);
    color: var(--color-text);
    font-family: var(--font-editorial);
    font-size: clamp(1.45rem, 1.1rem + 1vw, 2rem);
    line-height: 1;
  }

  .wedding-page :global(.wedding-packages__included-image) {
    width: min(100%, 40rem);
    margin: 0;
  }

  .wedding-page :global(.wedding-packages__keepsake) {
    display: grid;
    gap: 0.55rem;
    max-width: 24rem;
    margin-top: 1.25rem;
  }

  .wedding-page :global(.wedding-packages__keepsake p:first-child) {
    color: var(--color-text);
    font-family: var(--font-editorial);
    font-size: clamp(1.85rem, 1.45rem + 1.1vw, 2.65rem);
    line-height: 1;
  }

  .wedding-page :global(.wedding-packages__keepsake p:last-child) {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .wedding-page :global(.wedding-packages__list) {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .wedding-page :global(.wedding-packages__list li) {
    display: grid;
    gap: clamp(0.9rem, 2vw, 1.45rem);
    padding-block: clamp(1.35rem, 2.4vw, 2.15rem);
    border-bottom: 1px solid var(--color-line);
  }

  .wedding-page :global(.wedding-packages__duration) {
    color: var(--color-text);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .wedding-page :global(.wedding-packages h3) {
    font-family: var(--font-body);
    font-size: clamp(1.2rem, 1.02rem + 0.45vw, 1.55rem);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .wedding-page :global(.wedding-packages__details) {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
  }

  .wedding-page :global(.wedding-packages__details p) {
    font-size: clamp(0.96rem, 0.93rem + 0.12vw, 1.04rem);
    line-height: 1.55;
  }

  .wedding-page :global(.wedding-packages__price) {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    min-width: 0;
  }

  .wedding-page :global(.wedding-packages__price p) {
    max-width: 20rem;
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .wedding-page :global(.wedding-packages__price p:first-child) {
    color: var(--color-text);
    font-family: var(--font-editorial);
    font-size: clamp(2.05rem, 1.55rem + 1.25vw, 3.15rem);
    line-height: 0.95;
    white-space: nowrap;
  }

  .wedding-page :global(.wedding-packages__addon) {
    display: grid;
    gap: var(--space-sm);
    margin-top: clamp(3rem, 6vw, 5.5rem);
    padding-block: clamp(2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .wedding-page :global(.wedding-packages__addon-heading) {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }

  .wedding-page :global(.wedding-packages__addon h3) {
    max-width: 13ch;
    font-family: var(--font-editorial);
    font-size: clamp(2rem, 1.35rem + 2.15vw, 3.75rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 0.98;
    text-transform: none;
  }

  .wedding-page :global(.wedding-packages__addon-content),
  .wedding-page :global(.wedding-packages__addon-types),
  .wedding-page :global(.wedding-packages__addon-details) {
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
  }

  .wedding-page :global(.wedding-packages__addon-types section) {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .wedding-page :global(.wedding-packages__addon h4) {
    font-family: var(--font-editorial);
    font-size: clamp(1.65rem, 1.25rem + 1.15vw, 2.55rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1;
  }

  .wedding-page :global(.wedding-packages__addon-types p) {
    max-width: 32rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .wedding-page :global(.wedding-packages__addon-note) {
    color: var(--color-text);
    font-size: clamp(1rem, 0.95rem + 0.18vw, 1.12rem);
    font-weight: 500;
    line-height: 1.45;
  }

  .wedding-page :global(.wedding-packages__addon-details ul) {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wedding-page :global(.wedding-packages__addon-details li) {
    position: relative;
    padding-left: 1.35rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .wedding-page :global(.wedding-packages__addon-details li::before) {
    position: absolute;
    top: 0.74em;
    left: 0;
    width: 0.45rem;
    height: 1px;
    background: currentColor;
    content: "";
  }

  .wedding-page :global(.wedding-packages__addon-price) {
    width: fit-content;
    color: var(--color-text);
    font-family: var(--font-editorial);

---
import ImageSlot from "../components/ImageSlot.astro";
import DecorativeSectionNumber from "../components/DecorativeSectionNumber.astro";
import WeddingChapter from "../components/WeddingChapter.astro";
import WeddingFAQ from "../components/WeddingFAQ.astro";
import WeddingGallery from "../components/WeddingGallery.astro";
import WeddingPackages from "../components/WeddingPackages.astro";
import WeddingTrust from "../components/WeddingTrust.astro";
import { homeImages } from "../data/homeImages";
import { weddingGalleryAlts } from "../data/galleryAlts";
import { weddingFaq } from "../data/weddingFaq";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Photographe mariage Drôme, Valence & Provence | Life Focus";
const pageDescription =
  "Votre mariage, tel qu'il se vit vraiment. Les regards, les éclats de rire, les imprévus et tous ces instants que vous n'aviez pas vus. Photographe dans la Drôme.";

const weddingImage = (
  image: typeof homeImages[keyof typeof homeImages],
  slotPath: string,
  slotOrientation: "horizontal" | "vertical" = "horizontal",
) => ({
  ...image,
  slotPath,
  slotOrientation,
});

const chapterImageSet = [
  weddingImage(homeImages.hero, "src/images/mariage/preparation-1.jpg"),
  weddingImage(homeImages.weddingSecondary, "src/images/mariage/preparation-2.jpg", "vertical"),
  weddingImage(homeImages.weddingMain, "src/images/mariage/preparation-3.jpg"),
  weddingImage(homeImages.heroSecondary, "src/images/mariage/preparation-4.jpg", "vertical"),
] as const;

const chapters = [
  {
    number: "02",
    label: "PRÉPARATIFS",
    title: "Le calme avant l’arrivée des autres.",
    text: "Les préparatifs racontent déjà beaucoup de votre mariage : les proches qui arrivent, les derniers détails, l’émotion qui monte. Je photographie ces instants sans les interrompre, au plus près de ce qui se passe.",
    pattern: "a",
    images: chapterImageSet,
  },
  {
    number: "03",
    label: "CÉRÉMONIE",
    title: "Rester attentif à ce qui se joue vraiment.",
    text: "Les regards, les mains qui se cherchent, les réactions de vos proches, les silences. Pendant la cérémonie, je reste attentif à tout ce qui raconte votre histoire sans jamais prendre la place du moment.",
    pattern: "b",
    images: [
      weddingImage(homeImages.weddingMain, "src/images/mariage/ceremony-1.jpg"),
      weddingImage(homeImages.heroSecondary, "src/images/mariage/ceremony-2.jpg", "vertical"),
      weddingImage(homeImages.hero, "src/images/mariage/ceremony-3.jpg"),
      weddingImage(homeImages.weddingSecondary, "src/images/mariage/ceremony-4.jpg", "vertical"),
    ],
  },
  {
    number: "04",
    label: "COUPLE",
    title: "Quelques minutes pour souffler ensemble.",
    text: "Pas besoin de disparaître une heure de votre mariage pour avoir de belles photos de couple. Quelques minutes suffisent souvent. Je vous guide juste assez pour créer des images naturelles tout en vous laissant profiter l’un de l’autre.",
    pattern: "c",
    images: [weddingImage(homeImages.hero, "src/images/mariage/couple-1.jpg")],
  },
  {
    number: "05",
    label: "INVITÉS",
    title: "Les personnes qui donnent du relief à l'histoire.",
    text: "Un rire au cocktail, une discussion à l’écart, un regard pendant la cérémonie. Vos invités font partie intégrante du reportage et donnent à vos photos tout ce qui rend cette journée vraiment personnelle.",
    pattern: "a",
    images: [
      weddingImage(homeImages.weddingMain, "src/images/mariage/guests-1.jpg"),
      weddingImage(homeImages.hero, "src/images/mariage/guests-2.jpg"),
      weddingImage(homeImages.heroSecondary, "src/images/mariage/guests-3.jpg", "vertical"),
      weddingImage(homeImages.weddingSecondary, "src/images/mariage/guests-4.jpg", "vertical"),
    ],
  },
  {
    number: "06",
    label: "SOIRÉE",
    title: "Quand la journée devient plus libre.",
    text: "La lumière baisse, les discours laissent place à la fête et les gestes deviennent plus spontanés. Je continue à raconter votre mariage avec la même attention, jusque dans son énergie la plus libre.",
    pattern: "b",
    images: [
      weddingImage(homeImages.hero, "src/images/mariage/party-1.jpg"),
      weddingImage(homeImages.weddingMain, "src/images/mariage/party-2.jpg"),
    ],
  },
] as const;

const galleryImageFallbacks = [
  { ...homeImages.hero, size: "wide" },
  { ...homeImages.weddingSecondary, size: "vertical" },
  { ...homeImages.weddingMain, size: "small" },
  { ...homeImages.heroSecondary, size: "vertical" },
  { ...homeImages.hero, size: "small" },
  { ...homeImages.weddingMain, size: "wide" },
  { ...homeImages.weddingSecondary, size: "vertical" },
  { ...homeImages.hero, size: "small" },
  { ...homeImages.heroSecondary, size: "vertical" },
  { ...homeImages.weddingMain, size: "small" },
  { ...homeImages.hero, size: "wide" },
  { ...homeImages.weddingSecondary, size: "vertical" },
  { ...homeImages.weddingMain, size: "small" },
  { ...homeImages.heroSecondary, size: "vertical" },
  { ...homeImages.hero, size: "small" },
  { ...homeImages.weddingMain, size: "wide" },
  { ...homeImages.weddingSecondary, size: "vertical" },
  { ...homeImages.hero, size: "small" },
] as const;

const galleryImages = galleryImageFallbacks.map((image, index) => ({
  ...image,
  slotPath: `src/images/mariage/gallery/${String(index + 1).padStart(2, "0")}.jpg`,
  slotOrientation: image.size === "vertical" ? "vertical" : "horizontal",
}));

const structuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: weddingFaq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://www.lifefocus.fr/mariage/"
  alternateLinks={[
    { hreflang: "fr", href: "https://www.lifefocus.fr/mariage/" },
    { hreflang: "en", href: "https://www.lifefocus.fr/en/wedding-photographer-drome-provence/" },
  ]}
  structuredData={structuredData}
>
  <div class="wedding-page">
    <section class="wedding-hero" aria-labelledby="wedding-title">
      <div class="wedding-hero__inner">
        <div class="wedding-hero__images" aria-label="Reportage photo de mariage">
          <figure class="wedding-hero__main">
            <ImageSlot
              path="src/images/mariage/hero-main.jpg"
              orientation="horizontal"
              loading="eager"
              quality={92}
              sizes="(min-width: 72rem) 58vw, 90vw"
              label="Couple de mariés photographié pendant un reportage naturel."
            />
          </figure>

          <figure class="wedding-hero__secondary">
            <ImageSlot
              path="src/images/mariage/hero-secondary.jpg"
              orientation="vertical"
              loading="eager"
              quality={92}
              sizes="(min-width: 72rem) 20vw, 46vw"
              label="Portrait vertical de mariés en extérieur."
            />
          </figure>
        </div>

        <div class="wedding-hero__text">
          <p class="editorial-label">MARIAGE · DRÔME · PROVENCE</p>
          <h1 id="wedding-title">Photographe de mariage dans la Drôme et en Provence.</h1>
          <p>
            Basé à Romans-sur-Isère, près de Valence, je photographie les mariages avec une approche naturelle et spontanée, sans transformer votre journée en séance photo.
          </p>
        </div>
      </div>
    </section>

    <section class="wedding-approach page-shell decorative-section-number-frame" aria-labelledby="approach-title">
      <DecorativeSectionNumber value="01" placement="right" />
      <div class="wedding-approach__text decorative-section-number-content">
        <p class="editorial-label">01 / MON APPROCHE</p>
        <h2 id="approach-title">Une présence proche, mais jamais envahissante.</h2>
        <p>
          Je photographie votre mariage comme un reportage : les grands moments, les regards,
          les gestes et tout ce qui se passe entre les deux. Je vous guide lorsque c’est utile,
          puis je me fais discret pour laisser votre journée se vivre naturellement.
        </p>
        <WeddingTrust />
      </div>

      <figure class="wedding-approach__image decorative-section-number-content">
        <ImageSlot
          path="src/images/mariage/approach-main.jpg"
          orientation="horizontal"
          label="Couple marié en extérieur pendant un moment de reportage."
        />
      </figure>
    </section>

    {
      chapters.map((chapter) => (
        <WeddingChapter
          number={chapter.number}
          label={chapter.label}
          title={chapter.title}
          text={chapter.text}
          pattern={chapter.pattern}
          images={chapter.images}
        />
      ))
    }

    <section class="wedding-support" aria-labelledby="support-title">
      <div class="wedding-support__inner page-shell decorative-section-number-frame">
        <DecorativeSectionNumber value="07" placement="center" tone="dark" scale="quiet" />
        <div class="wedding-support__intro decorative-section-number-content">
          <p class="editorial-label">07 / MON ACCOMPAGNEMENT</p>
          <h2 id="support-title">Garder le fil sans prendre toute la place.</h2>
        </div>

        <div class="wedding-support__steps decorative-section-number-content">
          <section>
            <h3>AVANT</h3>
            <p>Un échange pour comprendre votre journée, votre organisation et les personnes qui comptent pour vous.</p>
          </section>
          <section>
            <h3>LE JOUR J</h3>
            <p>Une présence calme et attentive, avec quelques indications lorsque c’est utile et beaucoup de place laissée au naturel.</p>
          </section>
          <section>
            <h3>APRÈS</h3>
            <p>Une sélection soignée, un travail cohérent sur chaque image et une galerie privée pour revivre votre mariage.</p>
          </section>
        </div>
      </div>
    </section>

    <WeddingPackages />
    <div class="wedding-packages-next page-shell">
      <p>Pour préparer votre budget, retrouvez mes repères sur le <a href="/conseils/prix-photographe-mariage-drome/">prix d’un photographe de mariage dans la Drôme</a>.</p>
      <a class="editorial-link" href="/contact/">VÉRIFIER MA DISPONIBILITÉ →</a>
    </div>
    <WeddingGallery images={galleryImages} galleryFolder="src/images/mariage/gallery" altByPath={weddingGalleryAlts} />
    <WeddingFAQ />

    <section class="wedding-contact page-shell" aria-labelledby="wedding-contact-title">
      <h2 id="wedding-contact-title">Votre histoire commence ici.</h2>
      <a class="editorial-link" href="/contact/">ÉCRIVEZ-MOI →</a>
    </section>

    <nav class="wedding-useful-links page-shell" aria-labelledby="wedding-useful-links-title">
      <div>
        <p class="editorial-label">POUR ALLER PLUS LOIN</p>
        <h2 id="wedding-useful-links-title">Quelques repères pour votre journée.</h2>
      </div>
      <div class="wedding-useful-links__groups">
        <div>
          <h3>Photographe de mariage dans la région</h3>
          <ul>
            <li><a href="/photographe-mariage-romans-sur-isere/">Romans-sur-Isère</a></li>
            <li><a href="/photographe-mariage-valence/">Valence</a></li>
            <li><a href="/photographe-mariage-montelimar/">Montélimar</a></li>
            <li><a href="/photographe-mariage-ardeche/">Ardèche</a></li>
          </ul>
        </div>
        <div>
          <h3>Guides et informations</h3>
          <ul>
            <li><a href="/conseils/photographe-mariage-valence/">Conseils mariage à Valence</a></li>
            <li><a href="/conseils/photographe-mariage-romans-sur-isere/">Conseils mariage à Romans-sur-Isère</a></li>
            <li><a href="/en/wedding-photographer-drome-provence/">Wedding photography in English</a></li>
          </ul>
        </div>
      </div>
    </nav>
  </div>
</BaseLayout>

<style>
  .wedding-page {
    --service-narrow: 76rem;
  }

  .wedding-page :global(figure) {
    margin: 0;
    background: var(--color-line);
  }

  .wedding-page :global(img) {
    width: 100%;
    height: auto;
  }

  .wedding-hero {
    padding-block: clamp(0.75rem, 1.8vw, 1.5rem) clamp(4.5rem, 7vw, 6.5rem);
  }

  .wedding-hero__inner {
    display: grid;
    align-items: start;
    width: min(92vw, 82rem);
    margin-inline: auto;
    isolation: isolate;
    min-width: 0;
  }

  .wedding-hero__text {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0.85rem;
    width: min(100%, 38rem);
    margin-top: clamp(-3.5rem, -8vw, -1.8rem);
    margin-left: auto;
    padding: clamp(1.35rem, 2.35vw, 2.35rem);
    background: var(--color-surface-soft);
    min-width: 0;
    overflow-wrap: break-word;
  }

  .wedding-hero h1,
.wedding-approach h2,
.wedding-page :global(.wedding-chapter h2),
.wedding-support h2,
.wedding-page :global(.wedding-faq h2),
.wedding-contact h2 {
    font-family: var(--font-editorial);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .wedding-hero h1 {
    max-width: 12ch;
    font-size: clamp(2.55rem, 1.55rem + 3.15vw, 4.85rem);
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .wedding-hero p:not(.editorial-label),
.wedding-approach p:not(.editorial-label),
.wedding-page :global(.wedding-chapter__text p:not(.editorial-label)),
.wedding-support p,
.wedding-page :global(.wedding-faq p) {
    max-width: var(--reading-max);
    color: var(--color-muted);
  }

  .wedding-hero__images {
    position: relative;
    display: grid;
    align-items: end;
    isolation: isolate;
    z-index: 1;
    min-width: 0;
  }

  .wedding-hero__main {
    position: relative;
    z-index: 1;
  }

  .wedding-hero__secondary {
    position: relative;
    z-index: 2;
    width: min(48vw, 15rem);
    margin-top: calc(var(--space-sm) * -1);
    margin-left: auto;
  }

  .wedding-approach {
    --decorative-section-number-inline: clamp(0.55rem, 2vw, 1.6rem);
    --decorative-section-number-top: clamp(0.9rem, 3vw, 1.9rem);

    display: grid;
    gap: var(--space-md);
    align-items: end;
    max-width: var(--service-narrow);
    padding-block: clamp(3.75rem, 6vw, 5.5rem);
  }

  .wedding-approach__text {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }

  .wedding-approach h2 {
    max-width: 13ch;
    font-size: clamp(2.45rem, 1.55rem + 3vw, 5rem);
  }

  .wedding-approach__image {
    width: 100%;
  }

  .wedding-page :global(.wedding-chapter) {
    display: grid;
    gap: var(--space-md);
    max-width: var(--service-narrow);
    margin-inline: auto;
    padding: clamp(3.75rem, 6vw, 5.5rem) var(--page-padding);
  }

  .wedding-page :global(.wedding-chapter__text) {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }

  .wedding-page :global(.wedding-chapter h2) {
    max-width: 13ch;
    font-size: clamp(2.35rem, 1.5rem + 2.8vw, 4.8rem);
  }

  .wedding-page :global(.wedding-chapter__images) {
    position: relative;
    display: grid;
    gap: 1.1rem;
    align-items: start;
    isolation: isolate;
    min-width: 0;
  }

  .wedding-page :global(.wedding-chapter__image) {
    width: 100%;
  }

  .wedding-page :global(.wedding-chapter__image--2),
  .wedding-page :global(.wedding-chapter__image--4) {
    width: min(72vw, 22rem);
  }

  .wedding-page :global(.wedding-chapter__image--2) {
    margin-top: calc(var(--space-sm) * -0.65);
    margin-left: auto;
  }

  .wedding-page :global(.wedding-chapter__image--3) {
    width: min(64vw, 18rem);
  }

  .wedding-page :global(.wedding-chapter__image--4) {
    margin-left: auto;
  }

  .wedding-page :global(.wedding-chapter__images--2 .wedding-chapter__image--2) {
    margin-top: calc(var(--space-sm) * -0.35);
  }

  .wedding-support {
    margin-block: var(--space-lg);
    color: var(--color-background);
  }

  .wedding-support__inner {
    --decorative-section-number-center: 63%;
    --decorative-section-number-mobile-center: 68%;
    --decorative-section-number-top: clamp(1.1rem, 3.2vw, 2.35rem);
    --decorative-section-number-mobile-top: 1.35rem;

    display: grid;
    gap: var(--space-md);
    width: min(calc(100% - (var(--page-padding) * 1.4)), 84rem);
    margin-right: var(--page-padding);
    margin-left: auto;
    padding-block: clamp(4rem, 7vw, 6.5rem);
    background: var(--color-dark);
  }

  .wedding-support__intro {
    display: grid;
    gap: var(--space-xs);
  }

  .wedding-support h2 {
    max-width: 13ch;
    font-size: clamp(2.45rem, 1.55rem + 3vw, 5rem);
  }

  .wedding-support .editorial-label,
  .wedding-support p {
    color: color-mix(in srgb, var(--color-background) 76%, var(--color-white));
  }

  .wedding-support__steps {
    display: grid;
    gap: var(--space-sm);
  }

  .wedding-support__steps section {
    display: grid;
    gap: 0.8rem;
    padding-top: var(--space-xs);
    border-top: 1px solid color-mix(in srgb, var(--color-background) 22%, transparent);
  }

  .wedding-support h3 {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .wedding-page :global(.wedding-faq),
.wedding-contact {
    max-width: var(--service-narrow);
    padding-block: var(--space-lg);
  }

  .wedding-packages-next {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: .8rem 2rem;
    max-width: var(--service-narrow);
    padding-block: 0 var(--space-md);
  }

  .wedding-packages-next p { max-width: var(--reading-max); color: var(--color-muted); font-size: var(--text-sm); }
  .wedding-packages-next p a { color: var(--color-text); text-underline-offset: .2em; }

  .wedding-useful-links {
    display: grid;
    grid-template-columns: minmax(0, .7fr) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 3rem);
    max-width: var(--service-narrow);
    padding-block: var(--space-md) var(--space-lg);
    border-top: 1px solid var(--color-line);
  }

  .wedding-useful-links h2 {
    max-width: 15ch;
    font-family: var(--font-editorial);
    font-size: clamp(1.65rem, 1.3rem + 1vw, 2.35rem);
    font-weight: 400;
    line-height: 1.05;
  }

  .wedding-useful-links__groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 2rem; }
  .wedding-useful-links h3 { margin-bottom: .45rem; color: var(--color-muted); font-size: var(--text-xs); font-weight: 500; letter-spacing: .06em; text-transform: uppercase; }
  .wedding-useful-links ul { display: grid; gap: .3rem; margin: 0; padding: 0; list-style: none; }
  .wedding-useful-links a { color: var(--color-text); font-size: var(--text-sm); text-underline-offset: .2em; }

  .wedding-page :global(.wedding-faq__intro) {
    display: grid;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .wedding-page :global(.wedding-faq h2),
.wedding-contact h2 {
    max-width: 13ch;
    font-size: clamp(2.45rem, 1.55rem + 3vw, 5rem);
  }

  .wedding-page :global(.wedding-faq__items) {
    display: grid;
    border-top: 1px solid var(--color-line);
  }

  .wedding-page :global(.wedding-faq details) {
    border-bottom: 1px solid var(--color-line);
  }

  .wedding-page :global(.wedding-faq summary) {
    cursor: pointer;
    padding-block: 0.9rem;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .wedding-page :global(.wedding-faq summary:focus-visible) { outline: 2px solid currentColor; outline-offset: 3px; }

  .wedding-page :global(.wedding-faq details p) {
    padding-bottom: 0.9rem;
  }

  .wedding-contact {
    display: grid;
    gap: var(--space-sm);
    align-content: center;
    min-height: clamp(14rem, 22vw, 20rem);
  }

  @media (min-width: 48rem) {
    .wedding-support__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .wedding-hero {
      padding-bottom: clamp(5.5rem, 8vw, 7.5rem);
    }

    .wedding-hero__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .wedding-hero__images {
      grid-column: 4 / 13;
      grid-row: 1;
      grid-template-columns: repeat(10, minmax(0, 1fr));
      align-items: start;
      justify-self: end;
      width: min(64vw, 54rem);
    }

    .wedding-hero__main {
      grid-column: 1 / 9;
      grid-row: 1;
    }

    .wedding-hero__secondary {
      grid-column: 8 / 11;
      grid-row: 1;
      align-self: start;
      width: 100%;
      margin: 0 0 0 calc(var(--space-sm) * -0.55);
      transform: translateY(clamp(-4rem, -5vw, -2.75rem));
    }

    .wedding-hero__text {
      grid-column: 1 / 6;
      grid-row: 1;
      align-self: start;
      margin-top: clamp(2rem, 4.5vw, 3.75rem);
      margin-right: 0;
      margin-left: 0;
    }

    .wedding-approach {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
      gap: clamp(3rem, 7vw, 7rem);
    }

    .wedding-approach__image {
      align-self: end;
    }

    .wedding-page :global(.wedding-chapter) {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
      gap: clamp(3rem, 6vw, 6rem);
    }

    .wedding-page :global(.wedding-chapter__text) {
      grid-column: 1 / 5;
      align-self: start;
      padding-top: clamp(1rem, 3vw, 3rem);
    }

    .wedding-page :global(.wedding-chapter__images) {
      grid-column: 5 / 13;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 0;
    }

    .wedding-page :global(.wedding-chapter__image--1) {
      grid-column: 1 / 9;
      grid-row: 1 / 3;
      z-index: 1;
    }


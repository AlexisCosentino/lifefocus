---
import ImageSlot from "../../components/ImageSlot.astro";
import { adviceArticles } from "../../data/conseilsArticles";
import BaseLayout from "../../layouts/BaseLayout.astro";

const articles = adviceArticles
  .filter((article) => !article.draft)
  .sort(
    (a, b) =>
      b.publishedAt.getTime() - a.publishedAt.getTime(),
  );

const pageTitle = "Conseils mariage et photographie | Life Focus";
const pageDescription =
  "Conseils pratiques autour du mariage, de la photographie de couple et des images de famille par Life Focus, photographe dans la Drôme.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://lifefocus.fr/conseils/"
>
  <section class="advice-page page-shell" aria-labelledby="advice-title">
    <header class="advice-hero">
      <p class="editorial-label">CONSEILS</p>
      <h1 id="advice-title">Conseils autour de vos images et de votre mariage.</h1>
      <p>
        Des repères simples, issus du terrain, pour préparer vos images avec plus de clarté et
        moins de pression.
      </p>
    </header>

    <div class="advice-list" aria-label="Articles publiés">
      {
        articles.map((article, index) => (
            <article class="advice-item">
              <div class="advice-item__meta">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <span>{article.category}</span>
              </div>

              <div class="advice-item__text">
                <h2>
                  <a href={`/conseils/${article.slug}/`}>{article.title}</a>
                </h2>
                <p>{article.excerpt}</p>
                <a class="editorial-link" href={`/conseils/${article.slug}/`}>
                  LIRE L'ARTICLE ->
                </a>
              </div>

              <figure class="advice-item__image">
                <ImageSlot path={`src/images/conseils/${article.slug}.jpg`} orientation="horizontal" />
              </figure>
            </article>
          ))
      }
    </div>

    <footer class="advice-contact" aria-labelledby="advice-contact-title">
      <h2 id="advice-contact-title">Une question plus précise ?</h2>
      <a class="editorial-link" href="/contact/">ÉCRIRE À ALEXIS →</a>
    </footer>
  </section>
</BaseLayout>

<style>
  .advice-page {
    display: grid;
    gap: var(--space-lg);
    max-width: 84rem;
    padding-block: clamp(0.75rem, 1.8vw, 1.5rem) var(--space-lg);
    overflow-x: clip;
  }

  .advice-hero {
    display: grid;
    gap: var(--space-xs);
    max-width: 58rem;
  }

  .advice-hero h1,
  .advice-item h2,
  .advice-contact h2 {
    font-family: var(--font-editorial);
    font-weight: 400;
    letter-spacing: 0;
  }

  .advice-hero h1 {
    max-width: 14ch;
    font-size: clamp(3.1rem, 1.7rem + 4.5vw, 6.7rem);
    line-height: 0.96;
    text-wrap: balance;
  }

  .advice-hero p,
  .advice-item p {
    max-width: var(--reading-max);
    color: var(--color-muted);
  }

  .advice-list {
    display: grid;
    gap: var(--space-md);
  }

  .advice-item {
    display: grid;
    gap: var(--space-sm);
    align-items: start;
    padding-block: var(--space-md);
    border-top: 1px solid var(--color-line);
  }

  .advice-item__meta {
    display: flex;
    gap: 0.75rem;
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .advice-item__text {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }

  .advice-item h2 {
    max-width: 13ch;
    font-size: clamp(2.25rem, 1.45rem + 2.5vw, 4.5rem);
    line-height: 1;
  }

  .advice-item h2 a {
    text-decoration: none;
  }

  .advice-item h2 a:hover {
    color: var(--color-muted);
  }

  .advice-item__image {
    width: 100%;
    margin: 0;
    background: var(--color-line);
  }

  .advice-item__image :global(img) {
    width: 100%;
    height: auto;
  }

  .advice-contact {
    display: grid;
    gap: var(--space-sm);
    padding-block: var(--space-md) 0;
    border-top: 1px solid var(--color-line);
  }

  .advice-contact h2 {
    max-width: 12ch;
    font-size: clamp(2.5rem, 1.6rem + 3vw, 5rem);
    line-height: 1;
  }

  @media (min-width: 72rem) {
    .advice-hero {
      margin-left: clamp(5rem, 10vw, 12rem);
    }

    .advice-item {
      grid-template-columns: minmax(5rem, 0.2fr) minmax(0, 0.9fr) minmax(18rem, 0.62fr);
      gap: clamp(2rem, 4vw, 4rem);
    }

    .advice-item__image {
      margin-top: var(--space-xs);
    }

    .advice-contact {
      grid-template-columns: minmax(0, 0.55fr) minmax(0, 1fr);
    }

    .advice-contact h2,
    .advice-contact a {
      grid-column: 2;
    }
  }
</style>
